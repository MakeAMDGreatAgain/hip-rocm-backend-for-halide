+namespace {
+
+// Serializes every in-process lld invocation. lld keeps global state (its
+// error handler, the driver's option tables, the signal handlers it installs)
+// and is not safe to enter from two threads at once.
+std::mutex lld_mutex;
+
+// Set once an in-process link reports it cannot be run again (a fatal error
+// left lld's globals in an unknown state). From then on every link goes
+// through the external ld.lld.
+bool in_process_lld_poisoned = false;
+
+// Where HL_HIP_DUMP_OBJ writes to, or empty. The file name is
+// <first kernel>[.<n>].<ext> so repeated compiles of one pipeline don't
+// overwrite each other.
+void dump_code_object(const string &dir, const string &stem, const string &ext, const vector<char> &bytes) {
+    if (dir.empty()) {
+        return;
+    }
+    static std::mutex dump_mutex;
+    static std::map<string, int> seen;
+    string name;
+    {
+        std::lock_guard<std::mutex> lock(dump_mutex);
+        int n = seen[stem + ext]++;
+        name = stem + (n ? "." + std::to_string(n) : "") + ext;
+    }
+    string path = dir;
+    if (!path.empty() && path.back() != '/' && path.back() != '\\') {
+        path += '/';
+    }
+    path += name;
+    write_entire_file(path, bytes);
+    debug(1) << "HL_HIP_DUMP_OBJ: wrote " << bytes.size() << " bytes to " << path << "\n";
+}
+
+}  // namespace
+
+vector<char> CodeGen_AMDGPU_Dev::link_code_object(const vector<char> &object) {
+    TemporaryFile obj_file("halide_hip_", ".o");
+    TemporaryFile hsaco_file("halide_hip_", ".hsaco");
+    write_entire_file(obj_file.pathname(), object);
+
+    // This is exactly the link line clang uses for a HIP device link
+    // (minus the LTO plugin options, which don't apply to a plain object).
+    // -shared makes it ET_DYN, which is what hipModuleLoadData expects;
+    // --no-undefined turns any helper the device module failed to inline
+    // into a link error here instead of a load error on the GPU.
+    vector<string> arg_strs = {
+        "ld.lld",
+        "-flavor", "gnu",
+        "-m", "elf64_amdgpu",
+        "--no-undefined",
+        "-shared",
+        "-o", hsaco_file.pathname(),
+        obj_file.pathname()};
+
+    bool use_external = get_env_variable("HL_HIP_USE_EXTERNAL_LLD") == "1";
+    {
+        std::lock_guard<std::mutex> lock(lld_mutex);
+        if (in_process_lld_poisoned) {
+            use_external = true;
+        }
+    }
+
+    if (use_external) {
+        string lld_path = get_env_variable("HL_HIP_LLD");
+        if (lld_path.empty()) {
+            lld_path = "ld.lld";
+        }
+        arg_strs[0] = lld_path;
+        debug(1) << "Linking AMDGPU code object with external " << lld_path << "\n";
+        TemporaryFile log_file("halide_hip_lld_", ".log");
+        int rc = run_process(arg_strs, log_file.pathname(), log_file.pathname());
+        vector<char> log = read_entire_file(log_file.pathname());
+        string log_str(log.begin(), log.end());
+        if (rc == -1) {
+            user_error << "Could not run " << lld_path << " to link the HIP code object. "
+                       << "Set HL_HIP_LLD to the path of an ld.lld from the same LLVM "
+                       << "version as Halide, or unset HL_HIP_USE_EXTERNAL_LLD.\n";
+        }
+        internal_assert(rc == 0)
+            << lld_path << " failed with exit code " << rc << " while linking the HIP code object:\n"
+            << log_str;
+        if (!log_str.empty()) {
+            debug(1) << lld_path << ": " << log_str << "\n";
+        }
+    } else {
+        vector<const char *> lld_args;
+        lld_args.reserve(arg_strs.size());
+        for (const string &s : arg_strs) {
+            lld_args.push_back(s.c_str());
+        }
+
+        string lld_stdout, lld_stderr;
+        raw_string_ostream out_stream(lld_stdout);
+        raw_string_ostream err_stream(lld_stderr);
+
+        lld::Result r;
+        {
+            std::lock_guard<std::mutex> lock(lld_mutex);
+
+            // lld will temporarily hijack the signal handlers to ensure that temp
+            // files get cleaned up, but rather than preserving custom handlers in
+            // place, it restores the default handlers. This conflicts with some
+            // of our testing infrastructure, which relies on a SIGABRT handler set
+            // at global-ctor time to stay set. Therefore we'll save and restore
+            // this ourselves. (See the same dance in WasmExecutor.cpp.)
+            auto old_abort_handler = std::signal(SIGABRT, SIG_DFL);
+
+            r = lld::lldMain(lld_args, out_stream, err_stream, {{lld::Gnu, &lld::elf::link}});
+
+            std::signal(SIGABRT, old_abort_handler);
+
+            if (!r.canRunAgain) {
+                // lld hit a fatal error and its globals may be inconsistent.
+                // Never call lld::exitLld (it would kill the process); route
+                // every later link through the external linker instead.
+                in_process_lld_poisoned = true;
+            }
+        }
+        out_stream.flush();
+        err_stream.flush();
+
+        if (!lld_stdout.empty()) {
+            debug(1) << "ld.lld: " << lld_stdout << "\n";
+        }
+        internal_assert(r.retCode == 0 && r.canRunAgain)
+            << "In-process ld.lld failed to link the HIP code object (exit code " << r.retCode
+            << (r.canRunAgain ? "" : ", fatal") << "):\n"
+            << lld_stderr
+            << "Set HL_HIP_USE_EXTERNAL_LLD=1 (and HL_HIP_LLD=/path/to/ld.lld) to link "
+            << "with an external ld.lld instead.\n";
+        if (!lld_stderr.empty()) {
+            debug(1) << "ld.lld: " << lld_stderr << "\n";
+        }
+    }
+
+    return read_entire_file(hsaco_file.pathname());
+}
+
+vector<char> CodeGen_AMDGPU_Dev::compile_to_src() {
+    debug(2) << "In CodeGen_AMDGPU_Dev::compile_to_src";
+
+    internal_assert(module != nullptr);
+    if (!target_machine) {
+        target_machine = make_target_machine();
+    }
+    module->setDataLayout(target_machine->createDataLayout());
+
+    // Set up passes
+    llvm::SmallString<8> outstr;
+    raw_svector_ostream ostream(outstr);
+    ostream.SetUnbuffered();
+
+    // Denormal handling. Flushing f32 denormals to zero is the fast (and
+    // HIP's default) mode; strict float keeps them.
+    const char *denormal_mode = CodeGen_GPU_Dev::any_strict_float ? "ieee,ieee" : "preserve-sign,preserve-sign";
+    for (llvm::Function &fn : *module) {
+        if (!fn.isDeclaration()) {
+            fn.addFnAttr("denormal-fp-math-f32", denormal_mode);
+        }
+    }
+
+    const bool do_loop_opt = get_target().has_feature(Target::EnableLLVMLoopOpt);
+
+    // Define and run optimization pipeline with new pass manager
+    PipelineTuningOptions pto;
+    pto.LoopInterleaving = do_loop_opt;
+    pto.LoopVectorization = do_loop_opt;
+    pto.SLPVectorization = true;  // Note: SLP vectorization has no analogue in the Halide scheduling model
+    pto.LoopUnrolling = do_loop_opt;
+    pto.ForgetAllSCEVInLoopUnroll = true;
+
+    llvm::PassBuilder pb(target_machine.get(), pto);
+
+    // These analysis managers have to be declared in this order.
+    llvm::LoopAnalysisManager lam;
+    llvm::FunctionAnalysisManager fam;
+    llvm::CGSCCAnalysisManager cgam;
+    llvm::ModuleAnalysisManager mam;
+
+    // Register all the basic analyses with the managers.
+    pb.registerModuleAnalyses(mam);
+    pb.registerCGSCCAnalyses(cgam);
+    pb.registerFunctionAnalyses(fam);
+    pb.registerLoopAnalyses(lam);
+    pb.crossRegisterProxies(lam, fam, cgam, mam);
+    ModulePassManager mpm;
+
+    using OptimizationLevel = llvm::OptimizationLevel;
+    OptimizationLevel level = OptimizationLevel::O3;
+
+    // This is what adds the AMDGPU-specific passes (address space inference,
+    // LDS lowering, attributor, ...) to the default pipeline.
+    target_machine->registerPassBuilderCallbacks(pb);
+
+    mpm = pb.buildPerModuleDefaultPipeline(level);
+    mpm.run(*module, mam);
+
+    if (llvm::verifyModule(*module, &errs())) {
+        report_fatal_error("Transformation resulted in an invalid module\n");
+    }
+
+    // Optimization pipeline completed; run codegen pipeline
+
+    // NOTE: use of the "legacy" PassManager here is still required; it is deprecated
+    // for optimization, but is still the only complete API for codegen. See the
+    // matching comment in CodeGen_PTX_Dev::compile_to_src.
+    legacy::PassManager module_pass_manager;
+    module_pass_manager.add(createTargetTransformInfoWrapperPass(target_machine->getTargetIRAnalysis()));
+
+    // Ask the target to add backend passes as necessary. Unlike PTX (which is
+    // text), an AMDGPU code object is a relocatable ELF that still has to be
+    // linked before the HIP runtime can load it.
+    bool fail = target_machine->addPassesToEmitFile(module_pass_manager, ostream, nullptr,
+                                                    CodeGenFileType::ObjectFile, true);
+    internal_assert(!fail) << "Failed to set up passes to emit AMDGPU code object\n";
+    module_pass_manager.run(*module);
+
+    // Codegen pipeline completed.
+    debug(2) << [&] {
+        dump();
+        return "Done with CodeGen_AMDGPU_Dev::compile_to_src";
+    }();
+
+    debug(1) << "AMDGPU code object: " << outstr.size() << " bytes (ET_REL, unlinked)\n";
+
+    vector<char> object(outstr.begin(), outstr.end());
+
+    const string dump_dir = get_env_variable("HL_HIP_DUMP_OBJ");
+    const string dump_stem = kernel_names.empty() ? string("halide_hip_module") : kernel_names.front();
+    dump_code_object(dump_dir, dump_stem, ".o", object);
+
+    // hipModuleLoadData needs an ET_DYN code object, so link. Unlike PTX
+    // the result is binary: no trailing NUL. OffloadGPULoops embeds exactly
+    // these bytes and passes their count to halide_hip_initialize_kernels.
+    vector<char> hsaco = link_code_object(object);
+    debug(1) << "AMDGPU code object: " << hsaco.size() << " bytes (ET_DYN, linked)\n";
+
+    dump_code_object(dump_dir, dump_stem, ".hsaco", hsaco);
+
+    return hsaco;
+}
