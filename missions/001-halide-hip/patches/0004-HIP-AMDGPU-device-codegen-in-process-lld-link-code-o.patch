+// Validates the AMDGPU code objects the HIP backend embeds, without any AMD
+// hardware or the HIP runtime: compile a couple of tiny GPU pipelines for
+// fixed hip_gfx* targets, pull the embedded ".hsaco" bytes out of the
+// Module, and check the ELF the way hipModuleLoadData would.
+//
+// Tests only link against libHalide, which does not export LLVM's object
+// library, so the ELF is parsed by hand below.
+
+#include "Halide.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+using namespace Halide;
+
+namespace {
+
+// ELF constants (from the ELF spec and llvm/BinaryFormat/ELF.h).
+constexpr uint16_t ET_DYN = 3;
+constexpr uint16_t EM_AMDGPU = 224;
+constexpr uint8_t ELFOSABI_AMDGPU_HSA = 64;
+constexpr uint32_t SHT_SYMTAB = 2;
+constexpr uint32_t SHT_RELA = 4;
+constexpr uint32_t SHT_NOTE = 7;
+constexpr uint32_t SHT_DYNSYM = 11;
+constexpr uint64_t SHF_ALLOC = 2;
+constexpr uint16_t SHN_UNDEF = 0;
+constexpr uint8_t STT_OBJECT = 1;
+constexpr uint8_t STT_FUNC = 2;
+constexpr uint32_t NT_AMDGPU_METADATA = 32;
+constexpr uint32_t EF_AMDGPU_MACH = 0x0ff;
+constexpr uint32_t EF_AMDGPU_MACH_AMDGCN_GFX942 = 0x04c;
+constexpr uint32_t EF_AMDGPU_MACH_AMDGCN_GFX1100 = 0x041;
+
+struct Section {
+    std::string name;
+    uint32_t type = 0;
+    uint64_t flags = 0, addr = 0, offset = 0, size = 0;
+    uint32_t link = 0, info = 0;
+    uint64_t entsize = 0;
+};
+
+struct Symbol {
+    std::string name;
+    uint8_t type = 0;
+    uint16_t shndx = 0;
+    uint64_t value = 0, size = 0;
+};
+
+// A minimal reader for little-endian ELF64 files.
+class Elf {
+public:
+    Elf(const uint8_t *data, size_t size)
+        : data(data), size(size) {
+    }
+
+    uint8_t osabi = 0, abiversion = 0;
+    uint16_t type = 0, machine = 0;
+    uint32_t flags = 0;
+    std::vector<Section> sections;
+
+    bool parse(std::string &err) {
+        if (size < 64) {
+            err = "file is smaller than an ELF header";
+            return false;
+        }
+        if (memcmp(data, "\x7f"
+                         "ELF",
+                   4) != 0) {
+            err = "bad ELF magic";
+            return false;
+        }
+        if (data[4] != 2 /* ELFCLASS64 */) {
+            err = "not ELFCLASS64";
+            return false;
+        }
+        if (data[5] != 1 /* ELFDATA2LSB */) {
+            err = "not little-endian";
+            return false;
+        }
+        osabi = data[7];
+        abiversion = data[8];
+        type = u16(16);
+        machine = u16(18);
+        flags = u32(48);
+        uint64_t shoff = u64(40);
+        uint16_t shentsize = u16(58);
+        uint16_t shnum = u16(60);
+        uint16_t shstrndx = u16(62);
+        if (shentsize != 64 || !in_range(shoff, (uint64_t)shnum * 64)) {
+            err = "bad section header table";
+            return false;
+        }
+        for (uint16_t i = 0; i < shnum; i++) {
+            size_t off = (size_t)(shoff + (uint64_t)i * 64);
+            Section s;
+            s.type = u32(off + 4);
+            s.flags = u64(off + 8);
+            s.addr = u64(off + 16);
+            s.offset = u64(off + 24);
+            s.size = u64(off + 32);
+            s.link = u32(off + 40);
+            s.info = u32(off + 44);
+            s.entsize = u64(off + 56);
+            s.name = std::to_string(u32(off));  // patched below
+            sections.push_back(s);
+        }
+        if (shstrndx >= sections.size()) {
+            err = "bad e_shstrndx";
+            return false;
+        }
+        const Section &shstr = sections[shstrndx];
+        for (uint16_t i = 0; i < shnum; i++) {
+            size_t off = (size_t)(shoff + (uint64_t)i * 64);
+            sections[i].name = string_at(shstr, u32(off));
+        }
+        return true;
+    }
+
+    const Section *find_section(const std::string &name) const {
+        for (const Section &s : sections) {
+            if (s.name == name) {
+                return &s;
+            }
+        }
+        return nullptr;
+    }
+
+    std::vector<Symbol> symbols(const Section &symtab) const {
+        std::vector<Symbol> result;
+        if (symtab.entsize != 24 || symtab.link >= sections.size() ||
+            !in_range(symtab.offset, symtab.size)) {
+            return result;
+        }
+        const Section &strtab = sections[symtab.link];
+        for (uint64_t off = symtab.offset; off + 24 <= symtab.offset + symtab.size; off += 24) {
+            Symbol sym;
+            sym.name = string_at(strtab, u32((size_t)off));
+            sym.type = data[off + 4] & 0xf;
+            sym.shndx = u16((size_t)off + 6);
+            sym.value = u64((size_t)off + 8);
+            sym.size = u64((size_t)off + 16);
+            result.push_back(sym);
+        }
+        return result;
+    }
+
+    // All symbols from every SHT_SYMTAB / SHT_DYNSYM section.
+    std::vector<Symbol> all_symbols() const {
+        std::vector<Symbol> result;
+        for (const Section &s : sections) {
+            if (s.type == SHT_SYMTAB || s.type == SHT_DYNSYM) {
+                std::vector<Symbol> syms = symbols(s);
+                result.insert(result.end(), syms.begin(), syms.end());
+            }
+        }
+        return result;
+    }
+
+    // Finds a note of the given type and owner name in a SHT_NOTE section and
+    // returns its descriptor.
+    bool find_note(const Section &s, uint32_t want_type, const std::string &want_name,
+                   std::string &desc) const {
+        if (!in_range(s.offset, s.size)) {
+            return false;
+        }
+        uint64_t off = s.offset;
+        uint64_t end = s.offset + s.size;
+        while (off + 12 <= end) {
+            uint32_t namesz = u32((size_t)off);
+            uint32_t descsz = u32((size_t)off + 4);
+            uint32_t ntype = u32((size_t)off + 8);
+            uint64_t name_off = off + 12;
+            uint64_t desc_off = name_off + ((namesz + 3) & ~3u);
+            uint64_t next = desc_off + ((descsz + 3) & ~3u);
+            if (next > end) {
+                return false;
+            }
+            std::string name((const char *)data + name_off, namesz);
+            while (!name.empty() && name.back() == '\0') {
+                name.pop_back();
+            }
+            if (ntype == want_type && name == want_name) {
+                desc.assign((const char *)data + desc_off, descsz);
+                return true;
+            }
+            off = next;
+        }
+        return false;
+    }
+
+    // Reads n bytes at a virtual address, via the allocated section that
+    // contains it.
+    bool read_at_vaddr(uint64_t vaddr, size_t n, std::vector<uint8_t> &out) const {
+        for (const Section &s : sections) {
+            if ((s.flags & SHF_ALLOC) && s.type != 8 /* SHT_NOBITS */ &&
+                vaddr >= s.addr && vaddr + n <= s.addr + s.size) {
+                uint64_t off = s.offset + (vaddr - s.addr);
+                if (!in_range(off, n)) {
+                    return false;
+                }
+                out.assign(data + off, data + off + n);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    uint16_t u16(size_t off) const {
+        return (uint16_t)(data[off] | (data[off + 1] << 8));
+    }
+    uint32_t u32(size_t off) const {
+        return (uint32_t)data[off] | ((uint32_t)data[off + 1] << 8) |
+               ((uint32_t)data[off + 2] << 16) | ((uint32_t)data[off + 3] << 24);
+    }
+    uint64_t u64(size_t off) const {
+        return (uint64_t)u32(off) | ((uint64_t)u32(off + 4) << 32);
+    }
+
+private:
+    const uint8_t *data;
+    size_t size;
+
+    bool in_range(uint64_t off, uint64_t n) const {
+        return off <= size && n <= size - off;
+    }
+
+    std::string string_at(const Section &strtab, uint32_t idx) const {
+        if (!in_range(strtab.offset, strtab.size) || idx >= strtab.size) {
+            return "";
+        }
+        const char *start = (const char *)data + strtab.offset + idx;
+        size_t max_len = (size_t)(strtab.size - idx);
+        return std::string(start, strnlen(start, max_len));
+    }
+};
+
+int failures = 0;
+
+#define CHECK(cond, ...)                                            \
+    do {                                                            \
+        if (!(cond)) {                                              \
+            printf("FAIL [%s] %s:%d: ", label, __FILE__, __LINE__); \
+            printf(__VA_ARGS__);                                    \
+            printf("\n");                                           \
+            failures++;                                             \
+        }                                                           \
+    } while (0)
+
+// EI_ABIVERSION for the code object version the backend was asked for
+// (ELFABIVERSION_AMDGPU_HSA_V4 = 2, _V5 = 3, _V6 = 4).
+uint8_t expected_abi_version() {
+    const char *cov = getenv("HL_HIP_CODE_OBJECT_VERSION");
+    int v = cov ? atoi(cov) : 5;
+    return (uint8_t)(v - 2);
+}
+
+void check_code_object(const Buffer<> &code, const char *label, uint32_t expected_mach) {
+    CHECK(code.defined(), "no device code buffer was embedded in the Module");
+    if (!code.defined()) {
+        return;
+    }
+    CHECK(code.name().rfind("hip_", 0) == 0, "device code buffer is named %s, expected hip_*", code.name().c_str());
+
+    const uint8_t *bytes = (const uint8_t *)code.data();
+    size_t size = code.size_in_bytes();
+    printf("[%s] code object: %zu bytes\n", label, size);
+
+    // The bytes are a binary ELF, not NUL-terminated text: the file header
+    // starts at byte 0 and the size passed to the runtime is exact.
+    Elf elf(bytes, size);
+    std::string err;
+    if (!elf.parse(err)) {
+        CHECK(false, "not a parseable ELF64: %s", err.c_str());
+        return;
+    }
+
+    // File header.
+    CHECK(elf.machine == EM_AMDGPU, "e_machine is %u, expected EM_AMDGPU (224)", elf.machine);
+    CHECK(elf.osabi == ELFOSABI_AMDGPU_HSA, "EI_OSABI is %u, expected ELFOSABI_AMDGPU_HSA (64)", elf.osabi);
+    CHECK(elf.type == ET_DYN, "e_type is %u, expected ET_DYN (3): the object was not linked", elf.type);
+    CHECK(elf.abiversion == expected_abi_version(), "EI_ABIVERSION is %u, expected %u",
+          elf.abiversion, expected_abi_version());
+    CHECK((elf.flags & EF_AMDGPU_MACH) == expected_mach, "e_flags mach is 0x%x, expected 0x%x",
+          elf.flags & EF_AMDGPU_MACH, expected_mach);
+
+    // Kernels: every STT_FUNC symbol is a kernel entry point.
+    std::vector<Symbol> syms = elf.all_symbols();
+    std::vector<std::string> kernels;
+    for (const Symbol &s : syms) {
+        if (s.type == STT_FUNC && s.shndx != SHN_UNDEF && !s.name.empty()) {
+            bool seen = false;
+            for (const std::string &k : kernels) {
+                seen |= (k == s.name);
+            }
+            if (!seen) {
+                kernels.push_back(s.name);
+            }
+        }
+    }
+    CHECK(!kernels.empty(), "no STT_FUNC symbol (kernel) found");
+    for (const std::string &k : kernels) {
+        printf("[%s] kernel: %s\n", label, k.c_str());
+    }
+
+    // The metadata note the HIP runtime reads the kernarg layout from.
+    std::string metadata;
+    bool found_note = false;
+    for (const Section &s : elf.sections) {
+        if (s.type == SHT_NOTE && elf.find_note(s, NT_AMDGPU_METADATA, "AMDGPU", metadata)) {
+            found_note = true;
+            break;
+        }
+    }
+    CHECK(found_note, "no NT_AMDGPU_METADATA (type 32, name \"AMDGPU\") note");
+    if (found_note) {
+        // msgpack encodes the map keys and string values verbatim, so a
+        // substring search is enough to see the fields are there.
+        CHECK(metadata.find("amdhsa.kernels") != std::string::npos, "metadata lacks amdhsa.kernels");
+        CHECK(metadata.find(".kernarg_segment_size") != std::string::npos, "metadata lacks .kernarg_segment_size");
+        CHECK(metadata.find(".args") != std::string::npos, "metadata lacks .args");
+        for (const std::string &k : kernels) {
+            CHECK(metadata.find(k) != std::string::npos, "metadata does not mention kernel %s", k.c_str());
+        }
+    }
+
+    // Nothing may be left for the loader to resolve.
+    const Section *dynsym = elf.find_section(".dynsym");
+    CHECK(dynsym != nullptr, "no .dynsym section (hipModuleGetFunction looks kernels up there)");
+    if (dynsym) {
+        std::vector<Symbol> dsyms = elf.symbols(*dynsym);
+        for (size_t i = 1; i < dsyms.size(); i++) {
+            CHECK(dsyms[i].shndx != SHN_UNDEF, "undefined dynamic symbol: %s", dsyms[i].name.c_str());
+        }
+        bool has_kernel = false;
+        for (const Symbol &s : dsyms) {
+            for (const std::string &k : kernels) {
+                has_kernel |= (s.name == k);
+            }
+        }
+        CHECK(has_kernel, "no kernel is exported through .dynsym");
+    }
+    for (const Symbol &s : syms) {
+        CHECK(!(s.name == "__halide_dynamic_lds" && s.shndx == SHN_UNDEF),
+              "__halide_dynamic_lds survived as an undefined symbol (dynamic LDS was not lowered)");
+    }
+    for (const Section &s : elf.sections) {
+        if (s.type != SHT_RELA || s.entsize != 24 || s.link >= elf.sections.size()) {
+            continue;
+        }
+        std::vector<Symbol> rsyms = elf.symbols(elf.sections[s.link]);
+        for (uint64_t off = s.offset; off + 24 <= s.offset + s.size; off += 24) {
+            uint64_t info = elf.u64((size_t)off + 8);
+            uint32_t sym_idx = (uint32_t)(info >> 32);
+            if (sym_idx == 0) {
+                continue;  // base-relative (R_AMDGPU_RELATIVE64): resolved by the loader
+            }
+            const char *sym_name = sym_idx < rsyms.size() ? rsyms[sym_idx].name.c_str() : "?";
+            bool undefined = sym_idx < rsyms.size() && rsyms[sym_idx].shndx == SHN_UNDEF;
+            CHECK(!undefined, "%s has a relocation against undefined symbol %s", s.name.c_str(), sym_name);
+            if (!undefined) {
+                printf("[%s] note: %s has a symbolic relocation against %s\n", label, s.name.c_str(), sym_name);
+            }
+        }
+    }
+
+    // Kernel descriptors: group_segment_fixed_size@0, private@4, kernarg_size@8.
+    for (const std::string &k : kernels) {
+        const Symbol *kd = nullptr;
+        for (const Symbol &s : syms) {
+            if (s.name == k + ".kd" && s.shndx != SHN_UNDEF) {
+                kd = &s;
+                break;
+            }
+        }
+        CHECK(kd != nullptr, "no kernel descriptor symbol %s.kd", k.c_str());
+        if (!kd) {
+            continue;
+        }
+        CHECK(kd->type == STT_OBJECT, "%s.kd is not an STT_OBJECT symbol", k.c_str());
+        CHECK(kd->size == 64, "%s.kd has size %llu, expected 64", k.c_str(), (unsigned long long)kd->size);
+        std::vector<uint8_t> desc;
+        if (!elf.read_at_vaddr(kd->value, 64, desc)) {
+            CHECK(false, "could not read the 64 bytes of %s.kd", k.c_str());
+            continue;
+        }
+        Elf kd_view(desc.data(), desc.size());
+        uint32_t group_segment_fixed_size = kd_view.u32(0);
+        uint32_t kernarg_size = kd_view.u32(8);
+        printf("[%s] %s.kd: group_segment_fixed_size=%u kernarg_size=%u\n",
+               label, k.c_str(), group_segment_fixed_size, kernarg_size);
+        // Shared memory is always dynamic LDS sized at launch, so the static
+        // group segment must stay 0 whether or not the kernel uses any.
+        CHECK(group_segment_fixed_size == 0, "%s.kd group_segment_fixed_size is %u, expected 0 (dynamic LDS)",
+              k.c_str(), group_segment_fixed_size);
+        // Two buffer pointers (8 bytes each) at least.
+        CHECK(kernarg_size >= 16, "%s.kd kernarg_size is %u, expected >= 16", k.c_str(), kernarg_size);
+    }
+}
+
+enum class Variant {
+    Simple,  // out[x] = in[x] + p
+    Shared,  // a per-block Func staged in shared memory, with a barrier
+    Atomic,  // an f32 histogram with atomic updates
+};
+
+Buffer<> compile_pipeline(const Target &t, Variant variant) {
+    ImageParam in(Int(32), 1, "in");
+    Param<int> p("p");
+    Var x("x"), xo("xo"), xi("xi");
+    Func f("f");
+
+    if (variant == Variant::Atomic) {
+        // Two kernels in one code object: the atomic histogram update and
+        // the consumer. The f32 atomicrmw is what the
+        // !amdgpu.no.fine.grained.memory metadata gates on: with it the
+        // backend selects global_atomic_add_f32 on gfx942 instead of a
+        // compare-and-swap loop.
+        Func hist("hist");
+        Var i("i");
+        RDom r(0, 1024, "r");
+        RVar ro("ro"), ri("ri");
+        hist(i) = 0.0f;
+        hist(clamp(in(r), 0, 15)) += 1.0f;
+        hist.compute_root();
+        hist.update().atomic().gpu_tile(r, ro, ri, 64);
+        f(x) = cast<int>(hist(clamp(x, 0, 15))) + p;
+        f.gpu_tile(x, xo, xi, 64);
+    } else if (variant == Variant::Shared) {
+        // g is computed per block by the block's threads into shared memory,
+        // so the kernel has an LDS allocation and a barrier.
+        Func g("g");
+        g(x) = in(x) * 2;
+        f(x) = g(x) + g(x + 1) + p;
+        f.gpu_tile(x, xo, xi, 64);
+        g.compute_at(f, xo).gpu_threads(x);
+    } else {
+        f(x) = in(x) + p;
+        f.gpu_tile(x, xo, xi, 64);
+    }
+
+    Module m = f.compile_to_module({in, p}, "hip_code_object_test", t);
+    return m.get_device_code_buffer();
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    Target gfx942("host-hip-hip_gfx942");
+    if (!gfx942.supported()) {
+        printf("[SKIP] Halide was built without the AMDGPU backend (WITH_AMDGPU).\n");
+        return 0;
+    }
+    if (getenv("HL_HIP_ARCH")) {
+        printf("[SKIP] HL_HIP_ARCH is set; it overrides the hip_gfx* features this test checks.\n");
+        return 0;
+    }
+
+    check_code_object(compile_pipeline(gfx942, Variant::Simple), "gfx942", EF_AMDGPU_MACH_AMDGCN_GFX942);
+    check_code_object(compile_pipeline(gfx942, Variant::Shared), "gfx942+shared", EF_AMDGPU_MACH_AMDGCN_GFX942);
+    check_code_object(compile_pipeline(gfx942, Variant::Atomic), "gfx942+atomic", EF_AMDGPU_MACH_AMDGCN_GFX942);
+
+    Target gfx1100("host-hip-hip_gfx1100");
+    check_code_object(compile_pipeline(gfx1100, Variant::Simple), "gfx1100", EF_AMDGPU_MACH_AMDGCN_GFX1100);
+
+    if (failures) {
+        printf("%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("Success!\n");
+    return 0;
+}
