+bool CodeGen_AMDGPU_Dev::supports_atomic_add(const Type &t) const {
+    if (t.bits() < 32) {
+        // TODO(T7): packed f16/bf16 atomics exist on gfx90a+.
+        return false;
+    }
+    if (t.is_int_or_uint()) {
+        return true;
+    }
+    if (t.is_float() && t.bits() == 32) {
+        // Hardware on gfx908+, CAS loop elsewhere; either way LLVM lowers it.
+        return true;
+    }
+    if (t.is_float() && t.bits() == 64) {
+        // Hardware f64 atomics are a CDNA (gfx90a/gfx942/gfx950) feature.
+        // TODO(T7): refine per-arch; CAS fallback would make this always true.
+        const string mcpu = mcpu_target();
+        return mcpu == "gfx90a" || starts_with(mcpu, "gfx94") || starts_with(mcpu, "gfx95");
+    }
+    return false;
+}
