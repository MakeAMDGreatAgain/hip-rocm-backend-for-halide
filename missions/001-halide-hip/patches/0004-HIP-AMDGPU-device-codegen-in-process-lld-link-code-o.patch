+// Everything a "gfxNNN[:xnack-][:sramecc+]" target-id string breaks down into.
+// The LLVM -mcpu is the part before the first ':'; each ':feature[+-]' suffix
+// becomes a '+feature' / '-feature' entry for -mattr.
+struct HipArch {
+    string mcpu;
+    vector<string> features;
+};
+
+HipArch parse_hip_arch(const string &s) {
+    HipArch arch;
+    size_t pos = s.find(':');
+    arch.mcpu = s.substr(0, pos);
+    while (pos != string::npos) {
+        size_t next = s.find(':', pos + 1);
+        string f = s.substr(pos + 1, next == string::npos ? string::npos : next - pos - 1);
+        if (!f.empty()) {
+            char sign = f.back();
+            if (sign == '+' || sign == '-') {
+                f.pop_back();
+                arch.features.push_back(string(1, sign) + f);
+            } else {
+                arch.features.push_back("+" + f);
+            }
+        }
+        pos = next;
+    }
+    return arch;
+}
+
+// The GFX generation of an -mcpu string: gfx90a/gfx942/gfx950 -> 9,
+// gfx1030 -> 10, gfx1100/gfx1151 -> 11, gfx1201 -> 12, and likewise for the
+// "gfx9-generic" / "gfx10-3-generic" / "gfx11-generic" family names.
+// Returns 0 for anything it can't parse.
+int gfx_generation(const string &mcpu) {
+    if (!starts_with(mcpu, "gfx")) {
+        return 0;
+    }
+    string token;
+    for (size_t i = 3; i < mcpu.size() && std::isalnum((unsigned char)mcpu[i]); i++) {
+        token += mcpu[i];
+    }
+    string digits;
+    for (char c : token) {
+        if (!std::isdigit((unsigned char)c)) {
+            break;
+        }
+        digits += c;
+    }
+    if (digits.empty()) {
+        return 0;
+    }
+    if (token.size() >= 4) {
+        // gfx1030, gfx1100, ...: the first two digits are the generation.
+        return std::stoi(digits.substr(0, 2));
+    } else if (token.size() == 3) {
+        // gfx900, gfx90a, gfx942, ...: the first digit is the generation.
+        return digits[0] - '0';
+    } else {
+        // gfx9-generic, gfx10-3-generic, ...: the whole token is the generation.
+        return std::stoi(digits);
+    }
+}
+
+// The amdgcn address spaces we care about. (AMDGPUAddrSpace.h is a
+// target-internal header, so spell the numbers out; they are ABI.) Flat is
+// address space 0, i.e. CodeGen_LLVM's ptr_t.
+constexpr unsigned kAddrSpaceGlobal = 1;
+constexpr unsigned kAddrSpaceLocal = 3;
+
+// The name of the zero-length external LDS array that every shared-memory
+// allocation in a kernel is addressed through (the "dynamic LDS" idiom clang
+// uses for `extern __shared__`). The AMDGPU LDS-lowering pass places it just
+// after any static LDS, and hipModuleLaunchKernel's sharedMemBytes sizes it,
+// so the kernel descriptor's group_segment_fixed_size stays 0.
+const char *const kDynamicLDSName = "__halide_dynamic_lds";
+
+/** A code generator that emits AMDGPU code objects (HIP) from a given Halide stmt. */
+class CodeGen_AMDGPU_Dev : public CodeGen_LLVM, public CodeGen_GPU_Dev {
+public:
+    /** Create an AMDGPU device code generator. */
+    CodeGen_AMDGPU_Dev(const Target &host);
+    ~CodeGen_AMDGPU_Dev() override;
+
+    void add_kernel(Stmt stmt,
+                    const std::string &name,
+                    const std::vector<DeviceArgument> &args) override;
+
+    std::vector<char> compile_to_src() override;
+    std::string get_current_kernel_name() override;
+
+    void dump() override;
+
+    std::string print_gpu_name(const std::string &name) override;
+
+    std::string api_unique_name() override {
+        return "hip";
+    }
+
+protected:
+    using CodeGen_LLVM::visit;
+
+    /** (Re)initialize the AMDGPU module. This is separate from compile, since
+     * a device module will often have many kernels compiled into it for
+     * a single pipeline. */
+    /* override */ void init_module() override;
+
+    /** We hold onto the basic block at the start of the device
+     * function in order to inject allocas */
+    llvm::BasicBlock *entry_block;
+
+    /** Nodes for which we need to override default behavior for the GPU runtime */
+    // @{
+    void visit(const Call *) override;
+    void visit(const For *) override;
+    void visit(const Allocate *) override;
+    void visit(const Free *) override;
+    void visit(const AssertStmt *) override;
+    void visit(const Store *) override;
+    void visit(const Atomic *) override;
+    // @}
+
+    std::string mcpu_target() const override;
+    std::string mcpu_tune() const override;
+    std::string mattrs() const override;
+    bool use_soft_float_abi() const override;
+    int native_vector_bits() const override;
+    bool promote_indices() const override {
+        return false;
+    }
+
+    Type upgrade_type_for_arithmetic(const Type &t) const override {
+        return t;
+    }
+    Type upgrade_type_for_storage(const Type &t) const override;
+
+    /** Map from simt variable names (e.g. foo.block_id_x) to the llvm amdgcn
+     * intrinsic functions to call to get them. */
+    std::string simt_intrinsic(const std::string &name);
+
+    /** The target-id ("gfx942", "gfx1100:xnack-", ...) this module is being
+     * compiled for. HL_HIP_ARCH wins over the hip_gfx* target feature. */
+    HipArch hip_arch() const;
+
+    /** Build the TargetMachine for this module. Its data layout is the one
+     * source of truth for the module's layout. */
+    std::unique_ptr<llvm::TargetMachine> make_target_machine() const;
+
+    /** Created in init_module(), reused by compile_to_src(). */
+    std::unique_ptr<llvm::TargetMachine> target_machine;
+
+    /** The zero-length external LDS array shared-memory allocations are
+     * addressed through. Created lazily, once per module, by
+     * get_dynamic_lds(). */
+    llvm::GlobalVariable *dynamic_lds = nullptr;
+    llvm::GlobalVariable *get_dynamic_lds();
+
+    /** The kernels added to the current module, in order. Only used to name
+     * the files HL_HIP_DUMP_OBJ writes. */
+    std::vector<std::string> kernel_names;
+
+    /** Tag every atomicrmw / cmpxchg in a kernel with the metadata the AMDGPU
+     * backend needs before it will select hardware atomics. */
+    void annotate_atomics(llvm::Function &fn);
+
+    /** Link an ET_REL object emitted by the backend into the ET_DYN code
+     * object (.hsaco) the HIP runtime loads. */
+    std::vector<char> link_code_object(const std::vector<char> &object);
+
+    bool supports_atomic_add(const Type &t) const override;
+};
+
+CodeGen_AMDGPU_Dev::CodeGen_AMDGPU_Dev(const Target &host)
+    : CodeGen_LLVM(host) {
+    context = new llvm::LLVMContext();
+}
+
+CodeGen_AMDGPU_Dev::~CodeGen_AMDGPU_Dev() {
+    // This is required as destroying the context before the module
+    // results in a crash. Really, responsibility for destruction
+    // should be entirely in the parent class.
+    // TODO: Figure out how to better manage the context -- e.g. allow using
+    // same one as the host.
+    target_machine.reset();
+    module.reset();
+    delete context;
+}
+
+Type CodeGen_AMDGPU_Dev::upgrade_type_for_storage(const Type &t) const {
+    if (t.element_of() == Float(16)) {
+        return t;
+    }
+    return CodeGen_LLVM::upgrade_type_for_storage(t);
+}
+
+// The largest extent of each of the GPU thread loops, if they are all
+// constant. A kernel may contain several thread loops in sequence, so take the
+// largest of each.
+class BlockSize : public IRVisitor {
+    using IRVisitor::visit;
+
+    void visit(const For *op) override {
+        for (int i = 0; i < 3; i++) {
+            if (ends_with(op->name, gpu_thread_name(i))) {
+                if (auto e = as_const_int(simplify(op->extent()))) {
+                    extent[i] = std::max(extent[i], (int)*e);
+                } else {
+                    known = false;
+                }
+            }
+        }
+        IRVisitor::visit(op);
+    }
+
+public:
+    int extent[3] = {1, 1, 1};
+    bool known = true;
+};
+
+void CodeGen_AMDGPU_Dev::add_kernel(Stmt stmt,
+                                    const std::string &name,
+                                    const std::vector<DeviceArgument> &args) {
+    internal_assert(module != nullptr);
+
+    debug(2) << "In CodeGen_AMDGPU_Dev::add_kernel\n";
+
+    // Now deduce the types of the arguments to our function. Buffers arrive
+    // as global-memory pointers; scalars are passed by value.
+    llvm::PointerType *global_ptr_t = PointerType::get(*context, kAddrSpaceGlobal);
+    vector<llvm::Type *> arg_types(args.size());
+    for (size_t i = 0; i < args.size(); i++) {
+        if (args[i].is_buffer) {
+            arg_types[i] = global_ptr_t;
+        } else {
+            arg_types[i] = llvm_type_of(args[i].type);
+        }
+    }
+
+    // Make our function
+    FunctionType *func_t = FunctionType::get(void_t, arg_types, false);
+    function = llvm::Function::Create(func_t, llvm::Function::ExternalLinkage, name, module.get());
+    set_function_attributes_from_halide_target_options(*function);
+
+    // Mark the buffer args as no alias
+    for (size_t i = 0; i < args.size(); i++) {
+        if (args[i].is_buffer) {
+            function->addParamAttr(i, Attribute::NoAlias);
+        }
+    }
+
+    // The calling convention is what makes this a kernel (there is no
+    // nvvm.annotations-style metadata on AMDGPU).
+    function->setCallingConv(llvm::CallingConv::AMDGPU_KERNEL);
+
+    // Make the initial basic block
+    entry_block = BasicBlock::Create(*context, "entry", function);
+    builder->SetInsertPoint(entry_block);
+
+    // Put the arguments in the symbol table. The inherited CodeGen_LLVM
+    // code assumes flat (address space 0) pointers, so buffer arguments are
+    // cast to flat right here and the flat pointer is what the symbol table
+    // holds. The AMDGPU pipeline's InferAddressSpaces pass folds the casts
+    // back through the GEPs so loads and stores still become global_load /
+    // global_store rather than flat_load / flat_store.
+    vector<string> arg_sym_names;
+    {
+        size_t i = 0;
+        for (auto &fn_arg : function->args()) {
+            string arg_sym_name = args[i].name;
+            fn_arg.setName(arg_sym_name);
+            Value *sym_value = &fn_arg;
+            if (args[i].is_buffer) {
+                sym_value = builder->CreateAddrSpaceCast(&fn_arg, ptr_t, arg_sym_name + ".flat");
+            }
+            sym_push(arg_sym_name, sym_value);
+            arg_sym_names.push_back(arg_sym_name);
+            i++;
+        }
+    }
+
+    // We won't end the entry block yet, because we'll want to add
+    // some allocas to it later if there are local allocations. Start
+    // a new block to put all the code.
+    BasicBlock *body_block = BasicBlock::Create(*context, "body", function);
+    builder->SetInsertPoint(body_block);
+
+    debug(1) << "Generating llvm bitcode for kernel...\n";
+    // Ok, we have a module, function, context, and a builder
+    // pointing at a brand new basic block. We're good to go.
+    stmt.accept(this);
+
+    // Now we need to end the function
+    builder->CreateRetVoid();
+
+    // Make the entry block point to the body block
+    builder->SetInsertPoint(entry_block);
+    builder->CreateBr(body_block);
+
+    // Tell the backend the most work-items a work-group can have. Without
+    // this it assumes the maximum (1024) and budgets registers for it.
+    BlockSize block_size;
+    stmt.accept(&block_size);
+    int max_threads = 1024;
+    if (block_size.known) {
+        max_threads = std::min(max_threads,
+                               block_size.extent[0] * block_size.extent[1] * block_size.extent[2]);
+        debug(2) << "Kernel " << name << " has block size "
+                 << block_size.extent[0] << "x" << block_size.extent[1]
+                 << "x" << block_size.extent[2] << "\n";
+    }
+    function->addFnAttr("amdgpu-flat-work-group-size", "1," + std::to_string(max_threads));
+    // Halide always launches whole work-groups of the size it computed.
+    function->addFnAttr("uniform-work-group-size", "true");
+
+    annotate_atomics(*function);
+
+    // Now verify the function is ok. Unlike the PTX backend, fail loudly
+    // here: the address-space handling above is new enough that a broken
+    // kernel should be caught next to the code that produced it rather than
+    // by the module verifier after optimization.
+    internal_assert(!verifyFunction(*function, &errs()))
+        << "AMDGPU kernel " << name << " failed LLVM verification (see above)\n";
+
+    // Finally, verify the module is ok
+    internal_assert(!verifyModule(*module, &errs()))
+        << "AMDGPU module failed LLVM verification after adding kernel " << name << "\n";
+
+    kernel_names.push_back(name);
+
+    debug(2) << "Done generating llvm bitcode for AMDGPU\n";
+
+    // Clear the symbol table
+    for (const auto &arg_sym_name : arg_sym_names) {
+        sym_pop(arg_sym_name);
+    }
+}
+
+void CodeGen_AMDGPU_Dev::annotate_atomics(llvm::Function &fn) {
+    // Since LLVM 19 the AMDGPU backend only selects hardware read-modify-write
+    // atomics (notably the FP ones: global_atomic_add_f32 and friends) when
+    // the instruction promises that the memory is neither fine-grained nor
+    // remote; otherwise it expands to a CAS loop. Halide's device buffers are
+    // hipMalloc'd, i.e. coarse-grained device-local memory, so both promises
+    // hold. There is no hook in CodeGen_LLVM where the atomicrmw is created,
+    // so tag them after the fact.
+    MDNode *empty = MDNode::get(*context, {});
+    for (BasicBlock &bb : fn) {
+        for (Instruction &inst : bb) {
+            if (isa<AtomicRMWInst>(inst) || isa<AtomicCmpXchgInst>(inst)) {
+                inst.setMetadata("amdgpu.no.fine.grained.memory", empty);
+                inst.setMetadata("amdgpu.no.remote.memory", empty);
+            }
+        }
+    }
+}
+
+llvm::GlobalVariable *CodeGen_AMDGPU_Dev::get_dynamic_lds() {
+    if (!dynamic_lds) {
+        dynamic_lds = module->getGlobalVariable(kDynamicLDSName, /*AllowInternal=*/true);
+    }
+    if (!dynamic_lds) {
+        // @__halide_dynamic_lds = external addrspace(3) global [0 x i8], align 16
+        llvm::Type *array_t = ArrayType::get(i8_t, 0);
+        dynamic_lds = new GlobalVariable(*module, array_t, /*isConstant=*/false,
+                                         GlobalValue::ExternalLinkage, /*Initializer=*/nullptr,
+                                         kDynamicLDSName, /*InsertBefore=*/nullptr,
+                                         GlobalValue::NotThreadLocal, kAddrSpaceLocal,
+                                         /*isExternallyInitialized=*/false);
+        dynamic_lds->setAlignment(Align(16));
+    }
+    return dynamic_lds;
+}
+
+void CodeGen_AMDGPU_Dev::init_module() {
+    // This class uses multiple inheritance. It's a GPU device code generator,
+    // and also an llvm-based one. Both of these track strict_float presence,
+    // but OffloadGPULoops only sets the GPU device code generator flag, so here
+    // we set the CodeGen_LLVM flag to match.
+    CodeGen_LLVM::any_strict_float = CodeGen_GPU_Dev::any_strict_float;
+
+    init_context();
+
+    module = get_initial_module_for_amdgpu_device(target, context);
+    dynamic_lds = nullptr;
+    kernel_names.clear();
+
+    // The data layout comes from the TargetMachine, never from a string
+    // literal, so it cannot drift from the LLVM in use.
+    target_machine = make_target_machine();
+    module->setDataLayout(target_machine->createDataLayout());
+
+    // set_function_attributes_from_halide_target_options() reads these to
+    // stamp target-cpu / target-features on every kernel. Without them the
+    // attributes would be empty strings, and the AMDGPU backend treats an
+    // empty target-cpu as "generic" rather than falling back to the
+    // TargetMachine's CPU, which would produce the wrong ISA.
+    module->addModuleFlag(llvm::Module::Warning, "halide_mcpu_target", MDString::get(*context, mcpu_target()));
+    module->addModuleFlag(llvm::Module::Warning, "halide_mcpu_tune", MDString::get(*context, mcpu_tune()));
+    module->addModuleFlag(llvm::Module::Warning, "halide_mattrs", MDString::get(*context, mattrs()));
+
+    // Code object version. COV5 is what ROCm 5.x through 7.x runtimes accept;
+    // COV6 is opt-in (and required for the *-generic targets). The flag holds
+    // the version times 100. This must be set before any passes run.
+    int code_object_version = 5;
+    string cov_env = get_env_variable("HL_HIP_CODE_OBJECT_VERSION");
+    if (!cov_env.empty()) {
+        code_object_version = std::atoi(cov_env.c_str());
+        user_assert(code_object_version == 4 || code_object_version == 5 || code_object_version == 6)
+            << "HL_HIP_CODE_OBJECT_VERSION must be 4, 5 or 6, got " << cov_env << "\n";
+    }
+    module->addModuleFlag(llvm::Module::Error, "amdhsa_code_object_version", code_object_version * 100);
+
+    struct Intrinsic {
+        const char *name;
+        Type ret_type;
+        const char *intrin_name;
+        vector<Type> arg_types;
+    };
+
+    // TODO(T7): dot-product intrinsics (llvm.amdgcn.sdot4/udot4 on gfx908+)
+    // go here, mirroring the dp4a/dp2a table in CodeGen_PTX_Dev.
+    Intrinsic amdgpu_intrins[] = {
+        {"round", Float(32), "llvm.rint.f32", {Float(32)}},
+        {"round", Float(64), "llvm.rint.f64", {Float(64)}},
+    };
+
+    for (auto &&i : amdgpu_intrins) {
+        auto *fn = declare_intrin_overload(i.name, i.ret_type, i.intrin_name, std::move(i.arg_types));
+        function_does_not_access_memory(fn);
+        fn->addFnAttr(llvm::Attribute::NoUnwind);
+    }
+
+    if (CodeGen_GPU_Dev::any_strict_float) {
+        set_strict_fp_math();
+        in_strict_float = target.has_feature(Target::StrictFloat);
+    } else {
+        set_fast_fp_math();
+    }
+}
+
+void CodeGen_AMDGPU_Dev::visit(const Call *op) {
+    if (op->is_intrinsic(Call::gpu_thread_barrier)) {
+        internal_assert(op->args.size() == 1) << "gpu_thread_barrier() intrinsic must specify memory fence type.\n";
+
+        auto fence_type_ptr = as_const_int(op->args[0]);
+        internal_assert(fence_type_ptr) << "gpu_thread_barrier() parameter is not a constant integer.\n";
+
+        // s_barrier on its own is only an execution barrier; the memory
+        // ordering comes from the fences around it. Shared (LDS) traffic
+        // needs workgroup scope, global memory needs agent scope. A fence
+        // type of None still gets the workgroup-scope fences: they are
+        // cheap, and the PTX backend's barrier is a full CTA fence too.
+        const char *scope = (*fence_type_ptr & CodeGen_GPU_Dev::MemoryFenceType::Device) ? "agent" : "workgroup";
+        llvm::SyncScope::ID scope_id = context->getOrInsertSyncScopeID(scope);
+
+        llvm::Intrinsic::ID id = llvm::Intrinsic::lookupIntrinsicID("llvm.amdgcn.s.barrier");
+        internal_assert(id != llvm::Intrinsic::not_intrinsic)
+            << "Could not find AMDGPU barrier intrinsic llvm.amdgcn.s.barrier\n";
+        llvm::Function *barrier = llvm::Intrinsic::getOrInsertDeclaration(module.get(), id);
+
+        builder->CreateFence(llvm::AtomicOrdering::Release, scope_id);
+        builder->CreateCall(barrier);
+        builder->CreateFence(llvm::AtomicOrdering::Acquire, scope_id);
+
+        value = ConstantInt::get(i32_t, 0);
+        return;
+    }
+
+    if (op->is_intrinsic(Call::cuda_await_copies) ||
+        op->is_intrinsic(Call::cuda_bypass_registers)) {
+        // These implement MemoryType::GPUSharedAsync with cp.async, which has
+        // no AMDGPU counterpart yet. FuseGPUThreadLoops only emits them when
+        // the device API is CUDA (and demotes GPUSharedAsync to GPUShared
+        // everywhere else), so reaching here is a lowering bug, not a user
+        // error.
+        internal_error << "CodeGen_AMDGPU_Dev: " << op->name
+                       << " is a CUDA-only intrinsic (asynchronous shared-memory "
+                       << "copies are not supported on HIP)\n";
+    }
+
+    // TODO: It would be better if CodeGen_LLVM could handle overloaded intrin calls by default.
+    value = call_overloaded_intrin(op->type, op->name, op->args);
+    if (!value) {
+        CodeGen_LLVM::visit(op);
+    }
+}
+
+string CodeGen_AMDGPU_Dev::simt_intrinsic(const string &name) {
+    if (ends_with(name, gpu_thread_name(0))) {
+        return "llvm.amdgcn.workitem.id.x";
+    } else if (ends_with(name, gpu_thread_name(1))) {
+        return "llvm.amdgcn.workitem.id.y";
+    } else if (ends_with(name, gpu_thread_name(2))) {
+        return "llvm.amdgcn.workitem.id.z";
+    } else if (ends_with(name, gpu_block_name(0))) {
+        return "llvm.amdgcn.workgroup.id.x";
+    } else if (ends_with(name, gpu_block_name(1))) {
+        return "llvm.amdgcn.workgroup.id.y";
+    } else if (ends_with(name, gpu_block_name(2))) {
+        return "llvm.amdgcn.workgroup.id.z";
+    }
+    internal_error << "simt_intrinsic called on bad variable name\n";
+    return "";
+}
+
+void CodeGen_AMDGPU_Dev::visit(const For *loop) {
+    if (is_gpu(loop->for_type)) {
+        Expr simt_idx = Call::make(Int(32), simt_intrinsic(loop->name), std::vector<Expr>(), Call::Extern);
+        internal_assert(is_const_zero(loop->min));
+        sym_push(loop->name, codegen(simt_idx));
+        codegen(loop->body);
+        sym_pop(loop->name);
+    } else {
+        CodeGen_LLVM::visit(loop);
+    }
+}
+
+void CodeGen_AMDGPU_Dev::visit(const Allocate *alloc) {
+    user_assert(!alloc->new_expr.defined()) << "Allocate node inside AMDGPU kernel has custom new expression.\n"
+                                            << "(Memoization is not supported inside GPU kernels at present.)\n";
+    if (is_gpu_shared(alloc->memory_type)) {
+        // Every shared allocation in a kernel is addressed through the one
+        // dynamic-LDS array: FuseGPUThreadLoops has already folded all of
+        // them into offsets of a single allocation whose size the host
+        // passes as sharedMemBytes at launch. Never use a null pointer in
+        // address space 3 as the base: on AMDGPU LDS null is 0xFFFFFFFF.
+        //
+        // The symbol keeps its LDS (address space 3) pointer type. The
+        // inherited CodeGen_LLVM load/store code only ever GEPs from the
+        // symbol value (codegen_buffer_pointer), and GEPs preserve the
+        // address space, so accesses lower straight to ds_read / ds_write
+        // without a round trip through flat pointers.
+        sym_push(alloc->name, get_dynamic_lds());
+    } else {
+        debug(2) << "Allocate " << alloc->name << " on device\n";
+
+        string allocation_name = alloc->name;
+        debug(3) << "Pushing allocation called " << allocation_name << " onto the symbol table\n";
+
+        // Jump back to the entry and generate an alloca. Note that by
+        // jumping back we're rendering any expression we carry back
+        // meaningless, so we had better only be dealing with
+        // constants here.
+        int32_t size = alloc->constant_allocation_size();
+        internal_assert(size > 0)
+            << "Allocation " << alloc->name << " has a dynamic size. "
+            << "This should have been moved to the heap by the "
+            << "fuse_gpu_thread_loops lowering pass.\n";
+
+        BasicBlock *here = builder->GetInsertBlock();
+
+        builder->SetInsertPoint(entry_block);
+        // The amdgcn data layout puts allocas in the private address space
+        // (5); IRBuilder picks that up from the module. Cast to a flat
+        // pointer for the symbol table so inherited CodeGen_LLVM code that
+        // assumes address space 0 keeps working; InferAddressSpaces folds
+        // the cast back into scratch accesses.
+        AllocaInst *alloca = builder->CreateAlloca(llvm_type_of(alloc->type), ConstantInt::get(i32_t, size),
+                                                   allocation_name + ".private");
+        internal_assert(alloca->getAddressSpace() == module->getDataLayout().getAllocaAddrSpace());
+        Value *ptr = builder->CreateAddrSpaceCast(alloca, ptr_t, allocation_name);
+        builder->SetInsertPoint(here);
+        sym_push(allocation_name, ptr);
+    }
+    codegen(alloc->body);
+}
+
+void CodeGen_AMDGPU_Dev::visit(const Free *f) {
+    sym_pop(f->name);
+}
+
+void CodeGen_AMDGPU_Dev::visit(const AssertStmt *op) {
+    // Discard the error message for now. halide_amdgpu_trap (amdgpu_dev.ll)
+    // is llvm.trap, i.e. s_trap 2: the wave is killed and the runtime sees
+    // the dispatch fail on the next synchronization.
+    Expr trap = Call::make(Int(32), "halide_amdgpu_trap", {}, Call::Extern);
+    codegen(IfThenElse::make(!op->condition, Evaluate::make(trap)));
+}
+
+void CodeGen_AMDGPU_Dev::visit(const Store *op) {
+    // Issue atomic store if we are inside an Atomic node.
+    if (emit_atomic_stores) {
+        user_assert(is_const_one(op->predicate)) << "Atomic update does not support predicated store.\n";
+        user_assert(op->value.type().bits() >= 32) << "HIP: 8-bit or 16-bit atomics are not supported.\n";
+    }
+
+    // Unlike the PTX backend there is no i128 rewrite of aligned 4-wide
+    // 32-bit accesses here: the AMDGPU backend selects dwordx4 loads and
+    // stores for aligned <4 x i32>/<4 x float> on its own.
+    CodeGen_LLVM::visit(op);
+}
+
+void CodeGen_AMDGPU_Dev::visit(const Atomic *op) {
+    // All the lanes of a wavefront execute in lockstep, so a mutex loop
+    // would deadlock, exactly as it does in CUDA.
+    user_assert(op->mutex_name.empty())
+        << "The atomic update requires a mutex lock, which is not supported in HIP.\n";
+
+    // Issue atomic stores. The atomicrmw / cmpxchg instructions this produces
+    // get their !amdgpu.no.fine.grained.memory metadata in annotate_atomics()
+    // once the whole kernel body has been generated.
+    ScopedValue<bool> old_emit_atomic_stores(emit_atomic_stores, true);
+    CodeGen_LLVM::visit(op);
+}
+
+HipArch CodeGen_AMDGPU_Dev::hip_arch() const {
+    // The environment variable is the long tail: any gfx name LLVM knows,
+    // optionally with target-id features, and it wins over the target string.
+    string env = get_env_variable("HL_HIP_ARCH");
+    if (!env.empty()) {
+        return parse_hip_arch(env);
+    }
+    string arch = target.get_hip_arch_string();
+    user_assert(!arch.empty())
+        << "hip target requires a hip_gfx* feature or HL_HIP_ARCH "
+        << "(e.g. HL_HIP_ARCH=gfx942) to select the GPU architecture.\n";
+    return parse_hip_arch(arch);
+}
+
+string CodeGen_AMDGPU_Dev::mcpu_target() const {
+    return hip_arch().mcpu;
+}
+
+string CodeGen_AMDGPU_Dev::mcpu_tune() const {
+    return mcpu_target();
+}
+
+string CodeGen_AMDGPU_Dev::mattrs() const {
+    HipArch arch = hip_arch();
+    vector<string> features;
+    // gfx10 and later default to wave64 in LLVM unless told otherwise, but
+    // wave32 is the native (and HIP's default) mode there. gfx9 is wave64 only.
+    if (gfx_generation(arch.mcpu) >= 10) {
+        features.emplace_back("+wavefrontsize32");
+    }
+    features.insert(features.end(), arch.features.begin(), arch.features.end());
+    string extra = get_env_variable("HL_HIP_MATTRS");
+    if (!extra.empty()) {
+        features.push_back(extra);
+    }
+    string result;
+    for (const string &f : features) {
+        if (!result.empty()) {
+            result += ",";
+        }
+        result += f;
+    }
+    return result;
+}
