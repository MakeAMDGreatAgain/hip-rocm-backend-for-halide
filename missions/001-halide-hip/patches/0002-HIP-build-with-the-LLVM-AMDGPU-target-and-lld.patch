diff --git a/cmake/FindHalide_LLVM.cmake b/cmake/FindHalide_LLVM.cmake
index 2901ab3..a939f70 100644
--- a/cmake/FindHalide_LLVM.cmake
+++ b/cmake/FindHalide_LLVM.cmake
@@ -56,26 +56,34 @@ if (LLVM_FOUND)
         "${LLVM_DIR}/../lib/cmake/clang"  # LLVM found in $ROOT/cmake
     )
 
+    # Both the WebAssembly (lldWasm) and AMDGPU (lldELF, for linking HIP code
+    # objects in-process) backends need liblld. Look for it once, up front.
+    find_package(
+        LLD "${Halide_LLVM_VERSION}" EXACT
+        HINTS
+        "${LLVM_INSTALL_PREFIX}"
+        # Homebrew split the LLVM and LLD packages as of version 19, so
+        # having multiple LLVM versions installed leads to the newest
+        # LLD being found without this hint.
+        "${LLVM_DIR}/../../../../lld@${LLVM_VERSION_MAJOR}"
+        "${LLVM_DIR}/../lld"
+        "${LLVM_DIR}/../lib/cmake/lld"
+    )
+
     foreach (comp IN LISTS LLVM_TARGETS_TO_BUILD)
-        if (comp STREQUAL "WebAssembly")
+        if (comp STREQUAL "WebAssembly" OR comp STREQUAL "AMDGPU")
             set(Halide_LLVM_${comp}_FOUND 0)
 
-            find_package(
-                LLD "${Halide_LLVM_VERSION}" EXACT
-                HINTS
-                "${LLVM_INSTALL_PREFIX}"
-                # Homebrew split the LLVM and LLD packages as of version 19, so
-                # having multiple LLVM versions installed leads to the newest
-                # LLD being found without this hint.
-                "${LLVM_DIR}/../../../../lld@${LLVM_VERSION_MAJOR}"
-                "${LLVM_DIR}/../lld"
-                "${LLVM_DIR}/../lib/cmake/lld"
-            )
             if (NOT LLD_FOUND)
                 string(APPEND REASON_FAILURE_MESSAGE
-                    "WebAssembly was not found because liblld is missing. "
+                    "${comp} was not found because liblld is missing. "
                     "Did you `apt install liblld-dev` or `brew install lld`?\n"
                 )
+                if (comp STREQUAL "AMDGPU")
+                    # AMDGPU is an optional component, so a missing liblld would
+                    # otherwise drop it silently.
+                    message(STATUS "Halide_LLVM: disabling the AMDGPU backend because liblld was not found")
+                endif ()
                 continue()
             endif ()
 
@@ -85,10 +93,13 @@ if (LLVM_FOUND)
             # runtime. See: https://github.com/halide/Halide/issues/5471
             if (LLVM_LINK_LLVM_DYLIB AND NOT Halide_LLVM_SHARED_LIBS)
                 string(APPEND REASON_FAILURE_MESSAGE
-                    "WebAssembly was not found because LLD required by was linked to shared LLVM "
+                    "${comp} was not found because LLD required by was linked to shared LLVM "
                     "(LLVM_LINK_LLVM_DYLIB=${LLVM_LINK_LLVM_DYLIB}) but static LLVM was requested "
                     "(Halide_LLVM_SHARED_LIBS=${Halide_LLVM_SHARED_LIBS}).\n"
                 )
+                if (comp STREQUAL "AMDGPU")
+                    message(STATUS "Halide_LLVM: disabling the AMDGPU backend because LLD was linked to shared LLVM but static LLVM was requested")
+                endif ()
                 continue()
             endif ()
         endif ()
@@ -174,6 +185,11 @@ if (Halide_LLVM_FOUND)
             if (comp STREQUAL "WebAssembly")
                 target_include_directories(Halide_LLVM::WebAssembly INTERFACE ${LLD_INCLUDE_DIRS})
                 target_link_libraries(Halide_LLVM::WebAssembly INTERFACE lldWasm lldCommon)
+            elseif (comp STREQUAL "AMDGPU")
+                # The HIP backend links its ET_REL code objects into loadable
+                # ET_DYN .hsaco files with lld's ELF driver, in-process.
+                target_include_directories(Halide_LLVM::AMDGPU INTERFACE ${LLD_INCLUDE_DIRS})
+                target_link_libraries(Halide_LLVM::AMDGPU INTERFACE lldELF lldCommon)
             endif ()
         endif ()
     endforeach ()
