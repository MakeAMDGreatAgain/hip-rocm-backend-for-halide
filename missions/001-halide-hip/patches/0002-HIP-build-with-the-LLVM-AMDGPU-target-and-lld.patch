 WITH_NVPTX ?= $(findstring nvptx, $(LLVM_COMPONENTS))
+# The AMDGPU (HIP) backend also needs liblld (lldELF) to link code objects,
+# so only enable it by default when both the LLVM component and lld are present.
+WITH_AMDGPU ?= $(if $(wildcard $(LLVM_LIBDIR)/liblldELF.*),$(findstring amdgpu, $(LLVM_COMPONENTS)),)
 WITH_WEBASSEMBLY ?= $(findstring webassembly, $(LLVM_COMPONENTS))
