         if (t.has_feature(Target::OpenCL)) {
             if (t.os == Target::Windows) {
                 modules.push_back(get_initmod_windows_opencl(c, bits_64, debug));
@@ -1437,6 +1447,42 @@ std::unique_ptr<llvm::Module> get_initial_module_for_ptx_device(Target target, l
 }
 #endif
 
+#ifdef WITH_AMDGPU
+std::unique_ptr<llvm::Module> get_initial_module_for_amdgpu_device(Target target, llvm::LLVMContext *c) {
+    std::vector<std::unique_ptr<llvm::Module>> modules;
+    modules.push_back(get_initmod_amdgpu_dev_ll(c));
+
+    // TODO(T5): link the vendored ROCm device library (ocml.bc) here once it
+    // is embedded, mirroring get_initmod_ptx_libdevice_ll above.
+
+    link_modules(modules, target);
+
+    // As with the PTX backend, the AMDGPU backend does not handle calling
+    // functions. Mark all definitions (not extern declarations) as
+    // AvailableExternally so they are inlined or deleted and never survive
+    // into the emitted code object. Anything explicitly marked noinline is
+    // left alone so it stays out-of-line and callable.
+    for (auto &f : *modules[0]) {
+        if (!f.isDeclaration() && !f.hasFnAttribute(llvm::Attribute::NoInline)) {
+            f.setLinkage(llvm::GlobalValue::AvailableExternallyLinkage);
+        }
+    }
+
+    llvm::Triple triple("amdgcn-amd-amdhsa");
+    modules[0]->setTargetTriple(triple);
+
+    // Deliberately no hard-coded data layout here: link_modules() above
+    // stamped the host-ish layout for the (arch-unknown) device Target onto
+    // the module, which is wrong for amdgcn (it needs p5 allocas, 32-bit LDS
+    // pointers, etc.). Reset it to the empty layout and let
+    // CodeGen_AMDGPU_Dev::init_module() set the authoritative layout from
+    // the TargetMachine, so it can never drift from the LLVM in use.
+    modules[0]->setDataLayout(llvm::DataLayout(""));
+
+    return std::move(modules[0]);
+}
+#endif
