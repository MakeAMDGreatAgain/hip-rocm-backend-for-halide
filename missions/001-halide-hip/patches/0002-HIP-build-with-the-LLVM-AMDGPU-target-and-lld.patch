 PTX_DEVICE_INITIAL_MODULES=$(if $(WITH_NVPTX), $(BUILD_DIR)/initmod_ptx.libdevice_ll.o, )
 
+AMDGPU_CXX_FLAGS=$(if $(WITH_AMDGPU), -DWITH_AMDGPU, )
+AMDGPU_LLVM_CONFIG_LIB=$(if $(WITH_AMDGPU), amdgpu, )
+# The HIP backend links its code objects with lld's ELF driver in-process.
+# llvm-config does not know about lld, so these libraries are added by hand.
+AMDGPU_LLD_LIBS=$(if $(WITH_AMDGPU), -llldELF -llldCommon, )
+
