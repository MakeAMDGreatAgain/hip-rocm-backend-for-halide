+// A minimal msgpack decoder: just enough of the format to walk the AMDGPU
+// metadata note (maps, arrays, strings and integers; other types are
+// skipped and reported as Other).
+struct Msgpack {
+    enum Kind { Nil,
+                Bool,
+                Int,
+                Str,
+                Array,
+                Map,
+                Other };
+    Kind kind = Nil;
+    int64_t i = 0;
+    std::string s;
+    std::vector<Msgpack> items;                        // Array
+    std::vector<std::pair<Msgpack, Msgpack>> entries;  // Map
+
+    // Map lookup by string key; nullptr if absent (or not a map).
+    const Msgpack *get(const std::string &key) const {
+        if (kind != Map) {
+            return nullptr;
+        }
+        for (const auto &e : entries) {
+            if (e.first.kind == Str && e.first.s == key) {
+                return &e.second;
+            }
+        }
+        return nullptr;
+    }
+    bool is_int(int64_t v) const {
+        return kind == Int && i == v;
+    }
+    bool is_str(const std::string &v) const {
+        return kind == Str && s == v;
+    }
+};
+
+class MsgpackReader {
+public:
+    explicit MsgpackReader(const std::string &buf)
+        : buf(buf) {
+    }
+
+    bool read(Msgpack &out) {
+        if (!need(1)) {
+            return false;
+        }
+        uint8_t b = (uint8_t)buf[pos++];
+        if (b <= 0x7f) {  // positive fixint
+            out.kind = Msgpack::Int;
+            out.i = b;
+            return true;
+        }
+        if (b >= 0xe0) {  // negative fixint
+            out.kind = Msgpack::Int;
+            out.i = (int8_t)b;
+            return true;
+        }
+        if ((b & 0xf0) == 0x80) {  // fixmap
+            return read_map(out, b & 0x0f);
+        }
+        if ((b & 0xf0) == 0x90) {  // fixarray
+            return read_array(out, b & 0x0f);
+        }
+        if ((b & 0xe0) == 0xa0) {  // fixstr
+            return read_str(out, b & 0x1f);
+        }
+        switch (b) {
+        case 0xc0:
+            out.kind = Msgpack::Nil;
+            return true;
+        case 0xc2:
+        case 0xc3:
+            out.kind = Msgpack::Bool;
+            out.i = (b == 0xc3);
+            return true;
+        case 0xc4:  // bin 8/16/32: skipped
+        case 0xc5:
+        case 0xc6: {
+            size_t n = (size_t)1 << (b - 0xc4);
+            if (!need(n)) {
+                return false;
+            }
+            uint64_t len = be(n);
+            if (!need(len)) {
+                return false;
+            }
+            pos += (size_t)len;
+            out.kind = Msgpack::Other;
+            return true;
+        }
+        case 0xca:  // float 32/64: skipped
+        case 0xcb: {
+            size_t n = (b == 0xca) ? 4 : 8;
+            if (!need(n)) {
+                return false;
+            }
+            pos += n;
+            out.kind = Msgpack::Other;
+            return true;
+        }
+        case 0xcc:  // uint 8/16/32/64
+        case 0xcd:
+        case 0xce:
+        case 0xcf: {
+            size_t n = (size_t)1 << (b - 0xcc);
+            if (!need(n)) {
+                return false;
+            }
+            out.kind = Msgpack::Int;
+            out.i = (int64_t)be(n);
+            return true;
+        }
+        case 0xd0:  // int 8/16/32/64
+        case 0xd1:
+        case 0xd2:
+        case 0xd3: {
+            size_t n = (size_t)1 << (b - 0xd0);
+            if (!need(n)) {
+                return false;
+            }
+            int shift = 64 - 8 * (int)n;
+            out.kind = Msgpack::Int;
+            out.i = (int64_t)(be(n) << shift) >> shift;  // sign-extend
+            return true;
+        }
+        case 0xd9:  // str 8/16/32
+        case 0xda:
+        case 0xdb: {
+            size_t n = (size_t)1 << (b - 0xd9);
+            if (!need(n)) {
+                return false;
+            }
+            return read_str(out, be(n));
+        }
+        case 0xdc:  // array 16/32
+        case 0xdd: {
+            size_t n = (size_t)2 << (b - 0xdc);
+            if (!need(n)) {
+                return false;
+            }
+            return read_array(out, be(n));
+        }
+        case 0xde:  // map 16/32
+        case 0xdf: {
+            size_t n = (size_t)2 << (b - 0xde);
+            if (!need(n)) {
+                return false;
+            }
+            return read_map(out, be(n));
+        }
+        default:  // ext types: not used by the AMDGPU metadata
+            return false;
+        }
+    }
+
+private:
+    const std::string &buf;
+    size_t pos = 0;
+
+    bool need(uint64_t n) const {
+        return pos <= buf.size() && n <= buf.size() - pos;
+    }
+    // Big-endian unsigned integer of n bytes.
+    uint64_t be(size_t n) {
+        uint64_t v = 0;
+        for (size_t k = 0; k < n; k++) {
+            v = (v << 8) | (uint8_t)buf[pos++];
+        }
+        return v;
+    }
+    bool read_str(Msgpack &out, uint64_t len) {
+        if (!need(len)) {
+            return false;
+        }
+        out.kind = Msgpack::Str;
+        out.s.assign(buf.data() + pos, (size_t)len);
+        pos += (size_t)len;
+        return true;
+    }
+    bool read_array(Msgpack &out, uint64_t n) {
+        out.kind = Msgpack::Array;
+        for (uint64_t k = 0; k < n; k++) {
+            Msgpack v;
+            if (!read(v)) {
+                return false;
+            }
+            out.items.push_back(std::move(v));
+        }
+        return true;
+    }
+    bool read_map(Msgpack &out, uint64_t n) {
+        out.kind = Msgpack::Map;
+        for (uint64_t k = 0; k < n; k++) {
+            Msgpack key, value;
+            if (!read(key) || !read(value)) {
+                return false;
+            }
+            out.entries.emplace_back(std::move(key), std::move(value));
+        }
+        return true;
+    }
+};
