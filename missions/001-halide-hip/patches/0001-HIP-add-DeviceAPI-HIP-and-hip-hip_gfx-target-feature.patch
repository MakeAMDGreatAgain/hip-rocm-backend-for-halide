     case DeviceAPI::OpenCL:
         return Target::OpenCL;
     case DeviceAPI::Metal:
@@ -1732,12 +1876,23 @@ bool Target::get_runtime_compatible_target(const Target &other, Target &result)
         // These are true union features.
         CUDA,
         D3D12Compute,
+        HIP,
         Metal,
         NoNEON,
         OpenCL,
         Vulkan,
         WebGPU,
 
+        // hip_gfx* features name a single GPU architecture rather than a capability
+        // level, so they are checked for agreement below before the union is taken.
+        HIPGFX90A,
+        HIPGFX942,
+        HIPGFX950,
+        HIPGFX1030,
+        HIPGFX1100,
+        HIPGFX1151,
+        HIPGFX1201,
+
         // These features are actually intersection-y, but because targets only record the _highest_,
         // we have to put their union in the result and then take a lower bound.
         CUDACapability30,
@@ -1850,6 +2005,19 @@ bool Target::get_runtime_compatible_target(const Target &other, Target &result)
         return false;
     }
 
+    // Two targets that both name a HIP architecture must name the same one;
+    // a target with plain 'hip' (no hip_gfx*) is compatible with any of them.
+    {
+        const Feature hip_arch_a = get_hip_arch_feature();
+        const Feature hip_arch_b = other.get_hip_arch_feature();
+        if (hip_arch_a != FeatureEnd && hip_arch_b != FeatureEnd && hip_arch_a != hip_arch_b) {
+            debug(1) << "runtime targets must agree on the HIP architecture (hip_gfx*)\n"
+                     << "  this:  " << *this << "\n"
+                     << "  other: " << other << "\n";
+            return false;
+        }
+    }
+
     // Union of features is computed through bitwise-or, and masked away by the features we care about
     // Intersection of features is computed through bitwise-and and masked away, too.
     // We merge the bits via bitwise or.
