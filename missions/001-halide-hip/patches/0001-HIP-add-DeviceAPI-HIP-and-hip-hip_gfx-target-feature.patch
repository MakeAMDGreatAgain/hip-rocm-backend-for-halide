+Target::Feature Target::get_hip_arch_feature() const {
+    const Feature arch_features[] = {
+        HIPGFX90A,
+        HIPGFX942,
+        HIPGFX950,
+        HIPGFX1030,
+        HIPGFX1100,
+        HIPGFX1151,
+        HIPGFX1201,
+    };
+    for (Feature f : arch_features) {
+        if (has_feature(f)) {
+            return f;
+        }
+    }
+    return FeatureEnd;
+}
+
+std::string Target::get_hip_arch_string() const {
+    // HL_HIP_ARCH=<gfxNNN[:xnack-][:sramecc+]> overrides any hip_gfx* feature.
+    // Only the -mcpu part is returned here; the AMDGPU codegen reads any
+    // ':'-separated target attribute suffixes from the variable itself.
+    const std::string env_arch = Internal::get_env_variable("HL_HIP_ARCH");
+    if (!env_arch.empty()) {
+        return env_arch.substr(0, env_arch.find(':'));
+    }
+    switch (get_hip_arch_feature()) {
+    case HIPGFX90A:
+        return "gfx90a";
+    case HIPGFX942:
+        return "gfx942";
+    case HIPGFX950:
+        return "gfx950";
+    case HIPGFX1030:
+        return "gfx1030";
+    case HIPGFX1100:
+        return "gfx1100";
+    case HIPGFX1151:
+        return "gfx1151";
+    case HIPGFX1201:
+        return "gfx1201";
+    default:
+        return "";
+    }
+}
