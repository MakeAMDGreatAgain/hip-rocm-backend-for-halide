+Target::Feature calculate_host_hip_arch(Target t) {
+    const auto *interface = get_device_interface_for_device_api(DeviceAPI::HIP, t);
+    internal_assert(interface->compute_capability);
+    int major, minor;
+    int err = interface->compute_capability(nullptr, &major, &minor);
+    if (err != 0) {
+        user_warning << "Failed to query the HIP device architecture (error " << err << "). "
+                     << "No hip_gfx* feature will be set; set HL_HIP_ARCH or add an "
+                     << "explicit hip_gfx* target feature.\n";
+        return Target::FeatureEnd;
+    }
+    // halide_hip_compute_capability() encodes the device's gfx id as
+    // major = gfx generation and minor = the low byte of the gfx id, i.e.
+    // gfx90a -> (9, 0x0a), gfx942 -> (9, 0x42), gfx950 -> (9, 0x50),
+    // gfx1030 -> (10, 0x30), gfx1100 -> (11, 0x00), gfx1151 -> (11, 0x51),
+    // gfx1201 -> (12, 0x01).
+    struct {
+        int major, minor;
+        Target::Feature feature;
+    } const known_archs[] = {
+        {9, 0x0a, Target::HIPGFX90A},
+        {9, 0x42, Target::HIPGFX942},
+        {9, 0x50, Target::HIPGFX950},
+        {10, 0x30, Target::HIPGFX1030},
+        {11, 0x00, Target::HIPGFX1100},
+        {11, 0x51, Target::HIPGFX1151},
+        {12, 0x01, Target::HIPGFX1201},
+    };
+    for (const auto &arch : known_archs) {
+        if (arch.major == major && arch.minor == minor) {
+            return arch.feature;
+        }
+    }
+    static const char *const hex_digits = "0123456789abcdef";
+    std::string name = "gfx" + std::to_string(major);
+    name += hex_digits[(minor >> 4) & 0xf];
+    name += hex_digits[minor & 0xf];
+    user_warning << "The host HIP device (" << name << ") does not correspond to a known "
+                 << "hip_gfx* target feature. Set HL_HIP_ARCH=" << name << " (or add a "
+                 << "hip_gfx* feature) to select the GPU architecture to compile for.\n";
+    return Target::FeatureEnd;
+}
+
+Target::Feature get_host_hip_arch(Target t) {
+    static Target::Feature arch = calculate_host_hip_arch(t);
+    return arch;
+}
