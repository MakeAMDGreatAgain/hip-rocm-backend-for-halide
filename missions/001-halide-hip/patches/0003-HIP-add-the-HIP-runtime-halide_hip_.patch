+#ifndef HALIDE_MINI_HIP_H
+#define HALIDE_MINI_HIP_H
+
+// Minimal subset of the HIP (AMD ROCm) API types needed by hip.cpp, mirroring
+// mini_cuda.h. Nothing here is a full HIP header; only what the runtime uses.
+//
+// All values were transcribed from the ROCm headers on 2026-09-04:
+//   [A] https://raw.githubusercontent.com/ROCm/HIP/develop/include/hip/hip_runtime_api.h
+//       (hipError_t, hipDeviceAttribute_t (ROCm 6.x/7.x numbering), hipMemoryType,
+//        HIP_LAUNCH_PARAM_*, opaque handle typedefs, function prototypes)
+//   [B] https://raw.githubusercontent.com/ROCm/HIP/develop/include/hip/driver_types.h
+//       (hipDeviceptr_t, hipArray_t, HIP_MEMCPY3D, hipMemcpyKind)
+//   [C] https://raw.githubusercontent.com/ROCm/HIP/rocm-5.7.x/include/hip/hip_runtime_api.h
+//       (ROCm 5.x numbering of the AMD-specific attributes, i.e. hipDeviceAttributeGcnArch)
+//   [D] https://raw.githubusercontent.com/ROCm/clr/develop/hipamd/src/hip_device.cpp
+//       (how gcnArch / hipDeviceComputeCapability are computed by the driver)
+
+namespace Halide {
+namespace Runtime {
+namespace Internal {
+namespace Hip {
+
+// HIP uses the platform's default C calling convention everywhere (the Windows
+// build of HIP is 64-bit only, so there is no __stdcall variant as with CUDA).
+#define HIPAPI
+
+// [B] driver_types.h: `typedef void* hipDeviceptr_t;`. We keep HIP's exact
+// definition (a pointer, not an integer) so the function-pointer signatures in
+// hip_functions.h are ABI-identical to the real prototypes. halide_buffer_t
+// stores the handle in its uint64_t `device` field; hip.cpp converts with
+// (hipDeviceptr_t)(uintptr_t)buf->device and back with (uint64_t)(uintptr_t)p.
+typedef void *hipDeviceptr_t;
+
+typedef int hipDevice_t;                          /**< HIP device ordinal [A] */
+typedef struct ihipModule_t *hipModule_t;         /**< loaded code object [A] */
+typedef struct ihipModuleSymbol_t *hipFunction_t; /**< kernel handle [A] */
+typedef struct ihipStream_t *hipStream_t;         /**< stream [A] */
+typedef struct hipArray *hipArray_t;              /**< array (only appears in HIP_MEMCPY3D) [B] */
+struct hipPointerAttribute_t;                     /**< opaque; layout differs between ROCm 5 and 6 */
+struct hipDeviceProp_t;                           /**< opaque; layout differs between ROCm 5 and 6 */
+
+// [A] `typedef enum __HIP_NODISCARD hipError_t { ... } hipError_t;`. We use a
+// plain int for the typedef (ABI-identical) plus an enum of the values we need.
+typedef int hipError_t;
+
+enum hipError_enum {
+    hipSuccess = 0,
+    hipErrorInvalidValue = 1,
+    hipErrorOutOfMemory = 2,
+    hipErrorNotInitialized = 3,
+    hipErrorDeinitialized = 4,
+    hipErrorProfilerDisabled = 5,
+    hipErrorProfilerNotInitialized = 6,
+    hipErrorProfilerAlreadyStarted = 7,
+    hipErrorProfilerAlreadyStopped = 8,
+    hipErrorInvalidConfiguration = 9,
+    hipErrorInvalidPitchValue = 12,
+    hipErrorInvalidSymbol = 13,
+    hipErrorInvalidDevicePointer = 17,
+    hipErrorInvalidMemcpyDirection = 21,
+    hipErrorInsufficientDriver = 35,
+    hipErrorMissingConfiguration = 52,
+    hipErrorPriorLaunchFailure = 53,
+    hipErrorInvalidDeviceFunction = 98,
+    hipErrorNoDevice = 100,
+    hipErrorInvalidDevice = 101,
+    hipErrorInvalidImage = 200,
+    hipErrorInvalidContext = 201,
+    hipErrorContextAlreadyCurrent = 202,
+    hipErrorMapFailed = 205,
+    hipErrorUnmapFailed = 206,
+    hipErrorArrayIsMapped = 207,
+    hipErrorAlreadyMapped = 208,
+    hipErrorNoBinaryForGpu = 209,
+    hipErrorAlreadyAcquired = 210,
+    hipErrorNotMapped = 211,
+    hipErrorNotMappedAsArray = 212,
+    hipErrorNotMappedAsPointer = 213,
+    hipErrorECCNotCorrectable = 214,
+    hipErrorUnsupportedLimit = 215,
+    hipErrorContextAlreadyInUse = 216,
+    hipErrorPeerAccessUnsupported = 217,
+    hipErrorInvalidKernelFile = 218,
+    hipErrorInvalidGraphicsContext = 219,
+    hipErrorInvalidSource = 300,
+    hipErrorFileNotFound = 301,
+    hipErrorSharedObjectSymbolNotFound = 302,
+    hipErrorSharedObjectInitFailed = 303,
+    hipErrorOperatingSystem = 304,
+    hipErrorInvalidHandle = 400,
+    hipErrorIllegalState = 401,
+    hipErrorNotFound = 500,
+    hipErrorNotReady = 600,
+    hipErrorIllegalAddress = 700,
+    hipErrorLaunchOutOfResources = 701,
+    hipErrorLaunchTimeOut = 702,
+    hipErrorPeerAccessAlreadyEnabled = 704,
+    hipErrorPeerAccessNotEnabled = 705,
+    hipErrorSetOnActiveProcess = 708,
+    hipErrorContextIsDestroyed = 709,
+    hipErrorAssert = 710,
+    hipErrorHostMemoryAlreadyRegistered = 712,
+    hipErrorHostMemoryNotRegistered = 713,
+    hipErrorLaunchFailure = 719,
+    hipErrorCooperativeLaunchTooLarge = 720,
+    hipErrorNotSupported = 801,
+    hipErrorStreamCaptureUnsupported = 900,
+    hipErrorStreamCaptureInvalidated = 901,
+    hipErrorStreamCaptureMerge = 902,
+    hipErrorStreamCaptureUnmatched = 903,
+    hipErrorStreamCaptureUnjoined = 904,
+    hipErrorStreamCaptureIsolation = 905,
+    hipErrorStreamCaptureImplicit = 906,
+    hipErrorCapturedEvent = 907,
+    hipErrorStreamCaptureWrongThread = 908,
+    hipErrorGraphExecUpdateFailure = 910,
+    hipErrorUnknown = 999,
+    hipErrorRuntimeMemory = 1052,
+    hipErrorRuntimeOther = 1053,
+    hipErrorTbd = 1054
+};
+
+// [A] hipDeviceAttribute_t. The CUDA-compatible block starts at
+// hipDeviceAttributeCudaCompatibleBegin = 0 and is numbered implicitly
+// (alphabetically); the AMD-specific block starts at 10000. The values below
+// were computed by numbering the enum in [A] and cross-checked against [C]:
+// the CUDA-compatible values are IDENTICAL in ROCm 5.7 and ROCm 6.x/7.x.
+//
+// The AMD-specific block did change between 5.x and 6.x:
+//   ROCm 5.x [C]:  10001 hipDeviceAttributeArch, 10003 hipDeviceAttributeGcnArch,
+//                  10004 hipDeviceAttributeGcnArchName
+//   ROCm 6.x+ [A]: 10001 hipDeviceAttributeUnused3 ("Previously hipDeviceAttributeArch"),
+//                  10003 hipDeviceAttributeUnused4 ("Previously hipDeviceAttributeGcnArch"),
+//                  10004 hipDeviceAttributeUnused5 ("Previously hipDeviceAttributeGcnArchName")
+// so querying hipDeviceAttributeGcnArch on a ROCm 6+ runtime returns
+// hipErrorInvalidValue. hip.cpp therefore only uses it as a fallback.
+typedef enum {
+    hipDeviceAttributeCudaCompatibleBegin = 0,
+    hipDeviceAttributeComputeCapabilityMajor = 23,  /**< Major compute capability (= gfx ISA major, e.g. 9 for gfx942) */
+    hipDeviceAttributeMaxBlockDimX = 26,            /**< Max block size in width */
+    hipDeviceAttributeMaxBlockDimY = 27,            /**< Max block size in height */
+    hipDeviceAttributeMaxBlockDimZ = 28,            /**< Max block size in depth */
+    hipDeviceAttributeMaxGridDimX = 29,             /**< Max grid size in width */
+    hipDeviceAttributeMaxGridDimY = 30,             /**< Max grid size in height */
+    hipDeviceAttributeMaxGridDimZ = 31,             /**< Max grid size in depth */
+    hipDeviceAttributeMaxThreadsPerBlock = 56,      /**< Maximum number of threads per block */
+    hipDeviceAttributeComputeCapabilityMinor = 61,  /**< Minor compute capability (= gfx ISA minor, e.g. 4 for gfx942) */
+    hipDeviceAttributeMultiprocessorCount = 63,     /**< Number of compute units */
+    hipDeviceAttributeMaxSharedMemoryPerBlock = 74, /**< Maximum LDS bytes per workgroup */
+    hipDeviceAttributeTotalConstantMemory = 83,     /**< Constant memory size in bytes */
+    hipDeviceAttributeTotalGlobalMem = 84,          /**< Global memory available on device */
+    hipDeviceAttributeWarpSize = 87,                /**< Wavefront size (64 on gfx9, 32 on gfx10+) */
+    hipDeviceAttributeCudaCompatibleEnd = 9999,
+    hipDeviceAttributeAmdSpecificBegin = 10000,
+    hipDeviceAttributeGcnArch = 10003,     /**< ROCm 5.x ONLY: isa.major*100 + isa.minor*10 + isa.stepping ([D]); unused/invalid on ROCm 6+ */
+    hipDeviceAttributeGcnArchName = 10004, /**< ROCm 5.x ONLY; not usable through an int* anyway */
+    hipDeviceAttributeAmdSpecificEnd = 19999,
+    hipDeviceAttributeVendorSpecificBegin = 20000,
+} hipDeviceAttribute_t;
+
+// [A] hipMemoryType (used by HIP_MEMCPY3D).
+typedef enum hipMemoryType {
+    hipMemoryTypeUnregistered = 0,
+    hipMemoryTypeHost = 1,
+    hipMemoryTypeDevice = 2,
+    hipMemoryTypeManaged = 3,
+    hipMemoryTypeArray = 10,
+    hipMemoryTypeUnified = 11
+} hipMemoryType;
+
+// [B] hipMemcpyKind (not needed by the driver-style copy entry points we use,
+// kept for completeness / future hipMemcpy* use).
+typedef enum hipMemcpyKind {
+    hipMemcpyHostToHost = 0,
+    hipMemcpyHostToDevice = 1,
+    hipMemcpyDeviceToHost = 2,
+    hipMemcpyDeviceToDevice = 3,
+    hipMemcpyDefault = 4,
+    hipMemcpyDeviceToDeviceNoCU = 1024
+} hipMemcpyKind;
+
+// [B] HIP_MEMCPY3D, field order copied exactly. Note that unlike CUDA_MEMCPY3D
+// there are no reserved0/reserved1 members.
+typedef struct HIP_MEMCPY3D {
+    size_t srcXInBytes;          /**< Source X in bytes */
+    size_t srcY;                 /**< Source Y */
+    size_t srcZ;                 /**< Source Z */
+    size_t srcLOD;               /**< Source LOD */
+    hipMemoryType srcMemoryType; /**< Source memory type */
