+// Used to generate correct timings when tracing
+WEAK int halide_hip_device_sync(void *user_context, struct halide_buffer_t *) {
+    debug(user_context)
+        << "HIP: halide_hip_device_sync (user_context: " << user_context << ")\n";
+
+    Context ctx(user_context);
+    if (ctx.error()) {
+        return ctx.error();
+    }
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_before = halide_current_time_ns(user_context);
+#endif
+
+    hipStream_t stream = nullptr;
+    auto result = halide_hip_get_stream(user_context, ctx.device, &stream);
+    if (result) {
+        return result;
+    }
+    // Synchronizing the null stream waits for all work Halide enqueued on it;
+    // a user-provided stream is synchronized on its own.
+    hipError_t err = hipStreamSynchronize(stream);
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipStreamSynchronize failed");
+    }
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_after = halide_current_time_ns(user_context);
+    debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+
+    return halide_error_code_success;
+}
+
+WEAK int halide_hip_run(void *user_context,
+                        void *state_ptr,
+                        const char *entry_name,
+                        int blocksX, int blocksY, int blocksZ,
+                        int threadsX, int threadsY, int threadsZ,
+                        int shared_mem_bytes,
+                        size_t arg_sizes[],
+                        void *args[],
+                        int8_t arg_is_buffer[]) {
+
+    debug(user_context) << "HIP: halide_hip_run ("
+                        << "user_context: " << user_context << ", "
+                        << "entry: " << entry_name << ", "
+                        << "blocks: " << blocksX << "x" << blocksY << "x" << blocksZ << ", "
+                        << "threads: " << threadsX << "x" << threadsY << "x" << threadsZ << ", "
+                        << "shmem: " << shared_mem_bytes << "\n";
+
+    hipError_t err;
+    Context ctx(user_context);
+    if (ctx.error()) {
+        return ctx.error();
+    }
+
+    debug(user_context) << "Got device " << ctx.device << ".\n";
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_before = halide_current_time_ns(user_context);
+#endif
+
+    hipModule_t mod{};
+    bool found = compilation_cache.lookup(ctx.cache_key(), state_ptr, mod);
+    halide_abort_if_false(user_context, found && mod != nullptr);
+
+    debug(user_context) << "Got module " << (void *)mod << "\n";
+    hipFunction_t f;
+    err = hipModuleGetFunction(&f, mod, entry_name);
+    debug(user_context) << "Got function " << (void *)f << "\n";
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipModuleGetFunction failed for kernel ", entry_name,
+                         " (is the kernel symbol exported from the code object?)");
+    }
+
+    size_t num_args = 0;
+    while (arg_sizes[num_args] != 0) {
+        debug(user_context) << "    halide_hip_run " << (int)num_args
+                            << " " << (int)arg_sizes[num_args]
+                            << " [" << (*((void **)args[num_args])) << " ...] "
+                            << arg_is_buffer[num_args] << "\n";
+        num_args++;
+    }
+
+    // We need storage for both the arg and the pointer to it if if
+    // has to be translated.
+    void **translated_args = (void **)malloc((num_args + 1) * sizeof(void *));
+    uint64_t *dev_handles = (uint64_t *)malloc(num_args * sizeof(uint64_t));
+    for (size_t i = 0; i <= num_args; i++) {  // Get nullptr at end.
+        if (arg_is_buffer[i]) {
+            halide_abort_if_false(user_context, arg_sizes[i] == sizeof(uint64_t));
+            dev_handles[i] = ((halide_buffer_t *)args[i])->device;
+            translated_args[i] = &(dev_handles[i]);
+            debug(user_context) << "    halide_hip_run translated arg" << (int)i
+                                << " [" << (*((void **)translated_args[i])) << " ...]\n";
+        } else {
+            translated_args[i] = args[i];
+        }
+    }
+
+    hipStream_t stream = nullptr;
+    if (auto result = halide_hip_get_stream(user_context, ctx.device, &stream);
+        result != halide_error_code_success) {
+        error(user_context) << "HIP: In halide_hip_run, halide_hip_get_stream returned " << result << "\n";
+        free(dev_handles);
+        free(translated_args);
+        return result;
+    }
+
+    // Default path: hand hipModuleLaunchKernel the per-argument pointers and
+    // let it pack the kernarg segment from the code object's .args metadata
+    // (identical contract to cuLaunchKernel).
+    void **kernel_params = translated_args;
+    void **extra = nullptr;
+
+    // Debug path (HL_HIP_PACK_KERNARGS=1): pack the explicit arguments
+    // ourselves with natural alignment (buffers are 8-byte pointers, scalars
+    // use their own size) and pass the blob via `extra`. This bypasses HIP's
+    // metadata-driven packing and is only meant for diagnosing kernarg ABI
+    // mismatches; the code object's .args[].offset values remain the
+    // authoritative layout.
+    uint8_t *packed = nullptr;
+    size_t packed_size = 0;
+    void *extra_list[5];
+    if (env_flag_set(env_pack_kernargs, "HL_HIP_PACK_KERNARGS")) {
+        size_t offset = 0;
+        for (size_t i = 0; i < num_args; i++) {
+            size_t sz = arg_is_buffer[i] ? sizeof(uint64_t) : arg_sizes[i];
+            size_t al = sz < 16 ? sz : 16;
+            if (al == 0) {
+                al = 1;
+            }
+            offset = align_up(offset, al) + sz;
+        }
+        packed_size = align_up(offset, (size_t)16);
+        if (packed_size == 0) {
+            packed_size = 16;
+        }
+        packed = (uint8_t *)malloc(packed_size);
+        memset(packed, 0, packed_size);
+        offset = 0;
+        for (size_t i = 0; i < num_args; i++) {
+            size_t sz = arg_is_buffer[i] ? sizeof(uint64_t) : arg_sizes[i];
+            size_t al = sz < 16 ? sz : 16;
+            if (al == 0) {
+                al = 1;
+            }
+            offset = align_up(offset, al);
+            memcpy(packed + offset, translated_args[i], sz);
+            debug(user_context) << "    halide_hip_run packed arg" << (int)i
+                                << " at offset " << (int)offset << " size " << (int)sz << "\n";
+            offset += sz;
+        }
+        extra_list[0] = HIP_LAUNCH_PARAM_BUFFER_POINTER;
+        extra_list[1] = packed;
+        extra_list[2] = HIP_LAUNCH_PARAM_BUFFER_SIZE;
+        extra_list[3] = &packed_size;
+        extra_list[4] = HIP_LAUNCH_PARAM_END;
+        kernel_params = nullptr;
+        extra = extra_list;
+        debug(user_context) << "    halide_hip_run using packed kernargs (" << (int)packed_size << " bytes)\n";
+    }
+
+    err = hipModuleLaunchKernel(f,
+                                blocksX, blocksY, blocksZ,
+                                threadsX, threadsY, threadsZ,
+                                shared_mem_bytes,
+                                stream,
+                                kernel_params,
+                                extra);
+    free(packed);
+    free(dev_handles);
+    free(translated_args);
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipModuleLaunchKernel failed");
+    }
+
+#ifdef DEBUG_RUNTIME
+    err = hipDeviceSynchronize();
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipDeviceSynchronize failed");
+    }
+    uint64_t t_after = halide_current_time_ns(user_context);
+    debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+    return halide_error_code_success;
+}
+
