+WEAK halide_device_allocation_pool hip_allocation_pool;
+
+WEAK __attribute__((constructor)) void register_hip_allocation_pool() {
+    hip_allocation_pool.release_unused = &halide_hip_release_unused_device_allocations;
+    halide_register_device_allocation_pool(&hip_allocation_pool);
+}
