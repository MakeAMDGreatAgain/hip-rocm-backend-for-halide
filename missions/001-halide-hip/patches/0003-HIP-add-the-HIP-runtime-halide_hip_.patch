+WEAK int halide_hip_device_free(void *user_context, halide_buffer_t *buf) {
+    // halide_device_free, at present, can be exposed to clients and they
+    // should be allowed to call halide_device_free on any halide_buffer_t
+    // including ones that have never been used with a GPU.
+    if (buf->device == 0) {
+        return halide_error_code_success;
+    }
+
+    hipDeviceptr_t dev_ptr = (hipDeviceptr_t)(uintptr_t)buf->device;
+
+    debug(user_context)
+        << "HIP: halide_hip_device_free (user_context: " << user_context
+        << ", buf: " << buf << ")\n";
+
+    Context ctx(user_context);
+    if (ctx.error()) {
+        return ctx.error();
+    }
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_before = halide_current_time_ns(user_context);
+#endif
+
+    auto result = validate_device_pointer(user_context, buf);
+    if (result) {
+        return result;
+    }
+
+    hipError_t err = hipSuccess;
+    if (halide_can_reuse_device_allocations(user_context)) {
+        debug(user_context) << "    caching allocation for later use: " << (void *)(dev_ptr) << "\n";
+
+        FreeListItem *item = (FreeListItem *)malloc(sizeof(FreeListItem));
+        item->device = ctx.device;
+        item->size = quantize_allocation_size(buf->size_in_bytes());
+        item->ptr = dev_ptr;
+
+        // We don't want to use a buffer freed one stream on
+        // another, as there are no synchronization guarantees and
+        // everything is async.
+        result = halide_hip_get_stream(user_context, ctx.device, &item->stream);
+        if (result) {
+            free(item);
+            return result;
+        }
+
+        {
+            ScopedMutexLock lock(&free_list_lock);
+            item->next = free_list;
+            free_list = item;
+        }
+    } else {
+        debug(user_context) << "    hipFree " << (void *)(dev_ptr) << "\n";
+        err = hipFree(dev_ptr);
+        // If hipFree fails, it isn't likely to succeed later, so just drop
+        // the reference.
+    }
+    buf->device_interface->impl->release_module();
+    buf->device_interface = nullptr;
+    buf->device = 0;
+    if (err != hipSuccess) {
+        // We may be called as a destructor, so don't raise an error here.
+        return error_hip(user_context, err);
+    }
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_after = halide_current_time_ns(user_context);
+    debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+
+    return halide_error_code_success;
+}
+
+WEAK int halide_hip_device_release(void *user_context) {
+    debug(user_context)
+        << "HIP: halide_hip_device_release (user_context: " << user_context << ")\n";
+
+    // If we haven't even loaded libamdhip64, don't load it just to quit.
+    if (!hipInit) {
+        return halide_error_code_success;
+    }
+
+    int device = -1;
+    auto result = halide_hip_acquire_context(user_context, &device, false);
+    if (result) {
+        return result;
+    }
+
+    if (device >= 0) {
+        // It's possible that this is being called from the destructor of
+        // a static variable, in which case the runtime may already be
+        // shutting down.
+        hipError_t err = hipSetDevice(device);
+        if (err == hipSuccess) {
+            err = hipDeviceSynchronize();
+        }
+        if (err != hipSuccess && err != hipErrorDeinitialized) {
+            return error_hip(user_context, err);
+        }
+
+        // Dump the contents of the free list, ignoring errors.
+        (void)halide_hip_release_unused_device_allocations(user_context);
+
+        compilation_cache.delete_context(user_context, device_cache_key(device), hipModuleUnload);
+
+        // Only forget the device if we own it. There is nothing to destroy:
+        // HIP has no per-process context, and hipDeviceReset is deliberately
+        // NOT called because it would also destroy allocations made by other
+        // HIP users in this process.
+        {
+            ScopedMutexLock spinlock(&context_lock);
+
+            if (device == context_device) {
+                debug(user_context) << "    releasing HIP device " << device << "\n";
+                context_device = -1;
+            }
+        }  // spinlock
+    }
+
+    return halide_hip_release_context(user_context);
+}
+
+WEAK int halide_hip_device_malloc(void *user_context, halide_buffer_t *buf) {
+    debug(user_context)
+        << "HIP: halide_hip_device_malloc (user_context: " << user_context
+        << ", buf: " << buf << ")\n";
+
+    Context ctx(user_context);
+    if (ctx.error()) {
+        return ctx.error();
+    }
+
+    size_t size = buf->size_in_bytes();
+    if (halide_can_reuse_device_allocations(user_context)) {
+        size = quantize_allocation_size(size);
+    }
+    halide_abort_if_false(user_context, size != 0);
+    if (buf->device) {
+        // This buffer already has a device allocation
+        return validate_device_pointer(user_context, buf, size);
+    }
+
+    // Check all strides positive.
+    for (int i = 0; i < buf->dimensions; i++) {
+        halide_abort_if_false(user_context, buf->dim[i].stride >= 0);
+    }
+
+    debug(user_context) << "    allocating " << *buf << "\n";
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_before = halide_current_time_ns(user_context);
+#endif
+
+    hipDeviceptr_t p = nullptr;
+    FreeListItem *to_free = nullptr;
+    if (halide_can_reuse_device_allocations(user_context)) {
+        hipStream_t stream = nullptr;
+        auto result = halide_hip_get_stream(user_context, ctx.device, &stream);
+        if (result) {
+            return result;
+        }
+
+        ScopedMutexLock lock(&free_list_lock);
+        // Best-fit allocation. There are three tunable constants
+        // here. A bucket is claimed if the size requested is at least
+        // 7/8 of the size of the bucket. We keep at most 32 unused
+        // allocations. We round up each allocation size to its top 4
+        // most significant bits (see quantize_allocation_size).
+        FreeListItem *best = nullptr, *item = free_list;
+        FreeListItem **best_prev = nullptr, **prev_ptr = &free_list;
+        int depth = 0;
+        while (item) {
+            if ((size <= item->size) &&                              // Fits
+                (size >= (item->size / 8) * 7) &&                    // Not too much slop
+                (ctx.device == item->device) &&                      // Same device
+                (stream == item->stream) &&                          // Can only safely re-use on the same stream on which it was freed
+                ((best == nullptr) || (best->size > item->size))) {  // Better than previous best fit
+                best = item;
+                best_prev = prev_ptr;
+                prev_ptr = &item->next;
+                item = item->next;
+            } else if (depth > 32) {
+                // Allocations after here have not been used for a
+                // long time. Just detach the rest of the free list
+                // and defer the actual hipFree calls until after we
+                // release the free_list_lock.
+                to_free = item;
+                *prev_ptr = nullptr;
+                item = nullptr;
+                break;
+            } else {
+                prev_ptr = &item->next;
+                item = item->next;
+            }
+            depth++;
+        }
+
+        if (best) {
+            p = best->ptr;
+            *best_prev = best->next;
+            free(best);
+        }
+    }
+
+    while (to_free) {
+        FreeListItem *next = to_free->next;
+        hipFree(to_free->ptr);
+        free(to_free);
+        to_free = next;
+    }
+
+    if (!p) {
+        debug(user_context) << "    hipMalloc " << (uint64_t)size << " -> ";
+
+        // Quantize all allocation sizes to the top 4 bits, to make
+        // reuse likelier. Wastes on average 4% memory per allocation.
+
+        hipError_t err = hipMalloc((void **)&p, size);
+        if (err == hipErrorOutOfMemory) {
+            auto result = halide_hip_release_unused_device_allocations(user_context);
+            if (result) {
+                return result;
+            }
+            err = hipMalloc((void **)&p, size);
+        }
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, "hipMalloc failed");
+        }
+        debug(user_context) << (void *)p << "\n";
+    }
+    halide_abort_if_false(user_context, p);
+    buf->device = (uint64_t)(uintptr_t)p;
+    buf->device_interface = &hip_device_interface;
+    buf->device_interface->impl->use_module();
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_after = halide_current_time_ns(user_context);
+    debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+
+    return halide_error_code_success;
+}
+
+namespace {
+
+// Try to perform the (d+1)-dimensional copy described by c (innermost chunk
+// plus d strided dimensions, d <= 2) with a single hipDrvMemcpy3D. Returns
+// false (without touching anything) when the strides cannot be expressed as
+// pitch/height, in which case the caller falls back to recursion.
+WEAK bool hip_try_memcpy3d(void *user_context, const device_copy &c,
+                           uint64_t src, uint64_t dst, int d, bool from_host, bool to_host,
+                           hipStream_t stream, hipError_t &err) {
+    if (d < 1 || d > 2 || hipDrvMemcpy3D == nullptr) {
+        return false;
+    }
+    if (from_host && to_host) {
+        return false;  // plain memcpy handles this
+    }
+    if (env_flag_set(env_disable_memcpy3d, "HL_HIP_DISABLE_MEMCPY3D")) {
+        return false;
+    }
+
+    const uint64_t src_pitch = c.src_stride_bytes[0];
+    const uint64_t dst_pitch = c.dst_stride_bytes[0];
+    if (src_pitch < c.chunk_size || dst_pitch < c.chunk_size) {
+        return false;  // overlapping / broadcast rows: let the 1-D path handle it
+    }
+    uint64_t src_height = c.extent[0];
+    uint64_t dst_height = c.extent[0];
+    uint64_t depth = 1;
+    if (d == 2) {
+        // Slices must be a whole number of rows apart in both src and dst.
+        if (c.src_stride_bytes[1] == 0 || c.dst_stride_bytes[1] == 0 ||
+            c.src_stride_bytes[1] % src_pitch != 0 || c.dst_stride_bytes[1] % dst_pitch != 0) {
+            return false;
+        }
+        src_height = c.src_stride_bytes[1] / src_pitch;
+        dst_height = c.dst_stride_bytes[1] / dst_pitch;
+        if (src_height < c.extent[0] || dst_height < c.extent[0]) {
+            return false;
+        }
+        depth = c.extent[1];
+    }
+
+    HIP_MEMCPY3D copy;
+    memset(&copy, 0, sizeof(copy));
+    if (from_host) {
+        copy.srcMemoryType = hipMemoryTypeHost;
+        copy.srcHost = (const void *)(uintptr_t)src;
+    } else {
+        copy.srcMemoryType = hipMemoryTypeDevice;
+        copy.srcDevice = (hipDeviceptr_t)(uintptr_t)src;
+    }
+    copy.srcPitch = src_pitch;
+    copy.srcHeight = src_height;
+    if (to_host) {
+        copy.dstMemoryType = hipMemoryTypeHost;
+        copy.dstHost = (void *)(uintptr_t)dst;
+    } else {
+        copy.dstMemoryType = hipMemoryTypeDevice;
+        copy.dstDevice = (hipDeviceptr_t)(uintptr_t)dst;
+    }
+    copy.dstPitch = dst_pitch;
+    copy.dstHeight = dst_height;
+    copy.WidthInBytes = c.chunk_size;
+    copy.Height = c.extent[0];
+    copy.Depth = depth;
+
+    debug(user_context) << "    hipDrvMemcpy3D"
+                        << (stream && hipDrvMemcpy3DAsync ? "Async" : "")
+                        << " from " << (from_host ? "host" : "device")
+                        << " to " << (to_host ? "host" : "device") << ", "
+                        << (void *)(uintptr_t)src << " -> " << (void *)(uintptr_t)dst
+                        << ", width " << c.chunk_size << " bytes x " << c.extent[0]
+                        << " rows x " << depth << " slices (pitch " << src_pitch << "/" << dst_pitch << ")\n";
+    if (stream && hipDrvMemcpy3DAsync) {
+        err = hipDrvMemcpy3DAsync(&copy, stream);
+    } else {
+        err = hipDrvMemcpy3D(&copy);
+    }
+    return true;
+}
+
+WEAK int hip_do_multidimensional_copy(void *user_context, const device_copy &c,
+                                      uint64_t src, uint64_t dst, int d, bool from_host, bool to_host,
+                                      hipStream_t stream) {
+    if (d > MAX_COPY_DIMS) {
+        error(user_context) << "Buffer has too many dimensions to copy to/from GPU\n";
+        return halide_error_code_bad_dimensions;
+    } else if (d == 0) {
+        hipError_t err = hipSuccess;
+        const char *copy_name;
+        debug(user_context) << "    from " << (from_host ? "host" : "device")
+                            << " to " << (to_host ? "host" : "device") << ", "
+                            << (void *)(uintptr_t)src << " -> " << (void *)(uintptr_t)dst << ", " << c.chunk_size << " bytes\n";
+        if (!from_host && to_host) {
+            debug(user_context) << "hipMemcpyDtoH(" << (void *)(uintptr_t)dst << ", " << (void *)(uintptr_t)src << ", " << c.chunk_size << ")\n";
+            copy_name = "hipMemcpyDtoH";
+            if (stream) {
+                err = hipMemcpyDtoHAsync((void *)(uintptr_t)dst, (hipDeviceptr_t)(uintptr_t)src, c.chunk_size, stream);
+            } else {
+                err = hipMemcpyDtoH((void *)(uintptr_t)dst, (hipDeviceptr_t)(uintptr_t)src, c.chunk_size);
+            }
+        } else if (from_host && !to_host) {
+            debug(user_context) << "hipMemcpyHtoD(" << (void *)(uintptr_t)dst << ", " << (void *)(uintptr_t)src << ", " << c.chunk_size << ")\n";
+            copy_name = "hipMemcpyHtoD";
+            if (stream) {
+                err = hipMemcpyHtoDAsync((hipDeviceptr_t)(uintptr_t)dst, (const void *)(uintptr_t)src, c.chunk_size, stream);
+            } else {
+                err = hipMemcpyHtoD((hipDeviceptr_t)(uintptr_t)dst, (const void *)(uintptr_t)src, c.chunk_size);
+            }
+        } else if (!from_host && !to_host) {
+            debug(user_context) << "hipMemcpyDtoD(" << (void *)(uintptr_t)dst << ", " << (void *)(uintptr_t)src << ", " << c.chunk_size << ")\n";
+            copy_name = "hipMemcpyDtoD";
+            if (stream) {
+                err = hipMemcpyDtoDAsync((hipDeviceptr_t)(uintptr_t)dst, (hipDeviceptr_t)(uintptr_t)src, c.chunk_size, stream);
+            } else {
+                err = hipMemcpyDtoD((hipDeviceptr_t)(uintptr_t)dst, (hipDeviceptr_t)(uintptr_t)src, c.chunk_size);
+            }
+        } else if (dst != src) {
+            debug(user_context) << "memcpy(" << (void *)(uintptr_t)dst << ", " << (void *)(uintptr_t)src << ", " << c.chunk_size << ")\n";
+            // Could reach here if a user called directly into the
+            // HIP API for a device->host copy on a source buffer
+            // with device_dirty = false.
+            memcpy((void *)(uintptr_t)dst, (const void *)(uintptr_t)src, c.chunk_size);
+        }
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, copy_name, " failed");
+        }
+    } else {
+        // Up to two strided dimensions can be done as one 3D copy.
+        hipError_t err = hipSuccess;
+        if (hip_try_memcpy3d(user_context, c, src, dst, d, from_host, to_host, stream, err)) {
+            if (err != hipSuccess) {
+                return error_hip(user_context, err, "hipDrvMemcpy3D failed");
+            }
+            return halide_error_code_success;
+        }
+
+        ssize_t src_off = 0, dst_off = 0;
+        for (int i = 0; i < (int)c.extent[d - 1]; i++) {
+            auto result = hip_do_multidimensional_copy(user_context, c, src + src_off, dst + dst_off, d - 1, from_host, to_host, stream);
+            dst_off += c.dst_stride_bytes[d - 1];
+            src_off += c.src_stride_bytes[d - 1];
+            if (result) {
+                return result;
+            }
+        }
+    }
+    return halide_error_code_success;
+}
+}  // namespace
+
+WEAK int halide_hip_buffer_copy(void *user_context, struct halide_buffer_t *src,
+                                const struct halide_device_interface_t *dst_device_interface,
+                                struct halide_buffer_t *dst) {
+    // We only handle copies to hip or to host
+    halide_abort_if_false(user_context, dst_device_interface == nullptr ||
+                                            dst_device_interface == &hip_device_interface);
+
+    if ((src->device_dirty() || src->host == nullptr) &&
+        src->device_interface != &hip_device_interface) {
+        halide_abort_if_false(user_context, dst_device_interface == &hip_device_interface);
+        // This is handled at the higher level.
+        return halide_error_code_incompatible_device_interface;
+    }
+
+    bool from_host = (src->device_interface != &hip_device_interface) ||
+                     (src->device == 0) ||
+                     (src->host_dirty() && src->host != nullptr);
+    bool to_host = !dst_device_interface;
+
+    halide_abort_if_false(user_context, from_host || src->device);
+    halide_abort_if_false(user_context, to_host || dst->device);
+
+    device_copy c = make_buffer_copy(src, from_host, dst, to_host);
+
+    {
+        Context ctx(user_context);
+        if (ctx.error()) {
+            return ctx.error();
+        }
+
+        debug(user_context)
+            << "HIP: halide_hip_buffer_copy (user_context: " << user_context
+            << ", src: " << src << ", dst: " << dst << ")\n";
+
+#ifdef DEBUG_RUNTIME
+        uint64_t t_before = halide_current_time_ns(user_context);
+        if (!from_host) {
+            auto result = validate_device_pointer(user_context, src);
+            if (result) {
+                return result;
+            }
+        }
+        if (!to_host) {
+            auto result = validate_device_pointer(user_context, dst);
+            if (result) {
+                return result;
+            }
+        }
+#endif
+
+        hipStream_t stream = nullptr;
+        auto result = halide_hip_get_stream(user_context, ctx.device, &stream);
+        if (result) {
+            return result;
+        }
+
+        result = hip_do_multidimensional_copy(
+            user_context, c, c.src + c.src_begin, c.dst + c.dst_begin,
+            dst->dimensions, from_host, to_host, stream);
+        if (result) {
+            return result;
+        }
+
+#ifdef DEBUG_RUNTIME
+        uint64_t t_after = halide_current_time_ns(user_context);
+        debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+    }
+
+    return halide_error_code_success;
+}
+
