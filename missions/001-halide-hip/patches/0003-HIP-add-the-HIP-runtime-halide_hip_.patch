+
+WEAK int halide_hip_compute_capability(void *user_context, int *major, int *minor) {
+    if (!lib_hip && !hipInit) {
+        // If HIP can't be found, we want to return 0, 0 and it's not
+        // considered an error. So we should be very careful about
+        // looking for libamdhip64 without tripping any errors in the rest
+        // of this runtime.
+        void *sym = halide_hip_get_symbol(user_context, "hipInit");
+        if (!sym) {
+            *major = *minor = 0;
+            return halide_error_code_success;
+        }
+    }
+
+    {
+        Context ctx(user_context);
+        if (ctx.error()) {
+            return ctx.error();
+        }
+
+        auto result = get_hip_arch(user_context, ctx.device, major, minor);
+        if (result) {
+            return result;
+        }
+    }
+
+    return halide_error_code_success;
+}
