+extern "C" {
+WEAK int halide_hip_initialize_kernels(void *user_context, void **state_ptr, const char *src, int size) {
+    debug(user_context) << "HIP: halide_hip_initialize_kernels (user_context: " << user_context
+                        << ", state_ptr: " << state_ptr
+                        << ", src: " << (void *)src
+                        << ", size: " << size << "\n";
+
+    Context ctx(user_context);
+    if (ctx.error()) {
+        return ctx.error();
+    }
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_before = halide_current_time_ns(user_context);
+#endif
+
+    hipModule_t loaded_module;
+    if (!compilation_cache.kernel_state_setup(user_context, state_ptr, ctx.cache_key(), loaded_module,
+                                              compile_kernel, user_context, src, size)) {
+        return halide_error_code_generic_error;
+    }
+    halide_abort_if_false(user_context, loaded_module != nullptr);
+
+#ifdef DEBUG_RUNTIME
+    uint64_t t_after = halide_current_time_ns(user_context);
+    debug(user_context) << "    Time: " << (t_after - t_before) / 1.0e6 << " ms\n";
+#endif
+
+    return halide_error_code_success;
+}
+
+WEAK void halide_hip_finalize_kernels(void *user_context, void *state_ptr) {
+    Context ctx(user_context);
+    if (ctx.error() == halide_error_code_success) {
+        compilation_cache.release_hold(user_context, ctx.cache_key(), state_ptr);
+    }
+}
+
+WEAK int halide_hip_release_unused_device_allocations(void *user_context) {
+    FreeListItem *to_free;
+    {
+        ScopedMutexLock lock(&free_list_lock);
+        to_free = free_list;
+        free_list = nullptr;
+    }
+    while (to_free) {
+        debug(user_context) << "    hipFree " << (void *)(to_free->ptr) << "\n";
+        hipFree(to_free->ptr);
+        FreeListItem *next = to_free->next;
+        free(to_free);
+        to_free = next;
+    }
+    return halide_error_code_success;
+}
