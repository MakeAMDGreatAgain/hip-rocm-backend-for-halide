+namespace Halide {
+namespace Runtime {
+namespace Internal {
+namespace Hip {
+
+ALWAYS_INLINE int hex_digit_value(char c) {
+    if (c >= '0' && c <= '9') {
+        return c - '0';
+    }
+    if (c >= 'a' && c <= 'f') {
+        return c - 'a' + 10;
+    }
+    if (c >= 'A' && c <= 'F') {
+        return c - 'A' + 10;
+    }
+    return -1;
+}
+
+// Parse the digits following "gfx" in a target id ("gfx942", "gfx90a",
+// "gfx1100:sramecc+:xnack-", ...) into Halide's (major, minor) encoding:
+// major = decimal value of all but the last two characters, minor = last two
+// characters as hex. Returns false if the string is not of that form.
+WEAK bool parse_gfx_id(const char *s, int *major, int *minor) {
+    int digits[8];
+    int n = 0;
+    while (n < 8 && hex_digit_value(s[n]) >= 0) {
+        digits[n] = hex_digit_value(s[n]);
+        n++;
+    }
+    if (n < 3 || n > 6) {
+        return false;
+    }
+    int maj = 0;
+    for (int i = 0; i < n - 2; i++) {
+        if (digits[i] > 9) {
+            return false;  // the generation is always decimal
+        }
+        maj = maj * 10 + digits[i];
+    }
+    *major = maj;
+    *minor = digits[n - 2] * 16 + digits[n - 1];
+    return true;
+}
+
+// Determine the device's gfx ISA id in Halide's (major, minor) encoding.
+//
+// 1. gcnArchName from hipGetDeviceProperties. On ROCm >= 6 the exported symbol
+//    is hipGetDevicePropertiesR0600 (the unversioned name is kept for the
+//    ROCm 5 ABI); on ROCm 5.x only hipGetDeviceProperties exists. The struct
+//    layout differs between the two, so it is treated as opaque: the call
+//    fills a zeroed, generously oversized buffer and we scan it for
+//    "gfx<hex digits>". gcnArchName is the only string in the struct that
+//    contains a gfx id (the marketing name precedes it in both layouts).
+// 2. hipDeviceAttributeGcnArch (ROCm 5.x only; hipErrorInvalidValue on
+//    ROCm 6+): the driver computes it as major*100 + minor*10 + stepping
+//    (hip_device.cpp), where a letter stepping is >= 10, so gfx90a is 910 and
+//    gfx90c is 912. Those two are decoded explicitly; everything else is
+//    (N/100, ((N/10)%10) << 4 | N%10), e.g. 942 -> (9, 0x42), 1100 -> (11, 0).
+// 3. hipDeviceComputeCapability returns only the ISA major/minor (gfx942 ->
+//    9.4, gfx90a -> 9.0, indistinguishable from gfx900). The stepping is
+//    reported as 0 (gfx942 -> (9, 0x40)); Target.cpp will not find a matching
+//    hip_gfx* feature and will ask the user for HL_HIP_ARCH.
+WEAK int get_hip_arch(void *user_context, int device, int *major, int *minor) {
+    *major = 0;
+    *minor = 0;
+
+    // 1. gcnArchName.
+    if (hipGetDevicePropertiesR0600 != nullptr || hipGetDeviceProperties != nullptr) {
+        // hipDeviceProp_t is ~1.5 KB in ROCm 5 and ROCm 6/7 (three char[256]
+        // fields plus ~100 scalars); 64 KB leaves ample headroom for growth.
+        const size_t props_size = 64 * 1024;
+        char *props = (char *)malloc(props_size);
+        if (props) {
+            memset(props, 0, props_size);
+            hipError_t err;
+            const char *fn_name;
+            if (hipGetDevicePropertiesR0600 != nullptr) {
+                fn_name = "hipGetDevicePropertiesR0600";
+                err = hipGetDevicePropertiesR0600((hipDeviceProp_t *)props, device);
+            } else {
+                fn_name = "hipGetDeviceProperties";
+                err = hipGetDeviceProperties((hipDeviceProp_t *)props, device);
+            }
+            bool found = false;
+            if (err == hipSuccess) {
+                for (size_t i = 0; i + 4 <= props_size; i++) {
+                    if (props[i] == 'g' && props[i + 1] == 'f' && props[i + 2] == 'x' &&
+                        parse_gfx_id(props + i + 3, major, minor)) {
+                        debug(user_context) << "    HIP device " << device << " arch from " << fn_name
+                                            << " gcnArchName: gfx" << (props + i + 3) << " -> "
+                                            << *major << "/" << *minor << "\n";
+                        found = true;
+                        break;
+                    }
+                }
+                if (!found) {
+                    debug(user_context) << "    " << fn_name << " returned no gfx id\n";
+                }
+            } else {
+                debug(user_context) << "    " << fn_name << " failed: " << get_hip_error_name(err) << "\n";
+            }
+            free(props);
+            if (found) {
+                return halide_error_code_success;
+            }
+        }
+    }
+
+    // 2. ROCm 5.x hipDeviceAttributeGcnArch.
+    {
+        int gcn_arch = 0;
+        hipError_t err = hipDeviceGetAttribute(&gcn_arch, hipDeviceAttributeGcnArch, device);
+        if (err == hipSuccess && gcn_arch >= 100) {
+            if (gcn_arch == 910) {
+                *major = 9;
+                *minor = 0x0a;  // gfx90a
+            } else if (gcn_arch == 912) {
+                *major = 9;
+                *minor = 0x0c;  // gfx90c
+            } else {
+                *major = gcn_arch / 100;
+                *minor = (((gcn_arch / 10) % 10) << 4) | (gcn_arch % 10);
+            }
+            debug(user_context) << "    HIP device " << device << " arch from hipDeviceAttributeGcnArch: "
+                                << gcn_arch << " -> " << *major << "/" << *minor << "\n";
+            return halide_error_code_success;
+        }
+        debug(user_context) << "    hipDeviceAttributeGcnArch unavailable (" << get_hip_error_name(err) << ")\n";
+    }
+
+    // 3. Lossy fallback: ISA major/minor only.
+    {
+        int isa_major = 0, isa_minor = 0;
+        hipError_t err = hipDeviceComputeCapability(&isa_major, &isa_minor, device);
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, "hipDeviceComputeCapability failed");
+        }
+        *major = isa_major;
+        *minor = (isa_minor & 0xf) << 4;
+        debug(user_context) << "    HIP device " << device << " arch from hipDeviceComputeCapability: "
+                            << isa_major << "." << isa_minor << " -> " << *major << "/" << *minor
+                            << " (stepping unknown; set HL_HIP_ARCH=gfxNNNN)\n";
+    }
+    return halide_error_code_success;
+}
+
+WEAK const char *get_hip_error_name(hipError_t err) {
+    // Errors with Halide-specific meaning first; then the runtime's own
+    // table when we have it; then our static table.
+    switch (err) {
+    // A trap instruction (s_trap 2, from llvm.trap) surfaces as a launch
+    // failure on the next synchronization, which is how we codegen asserts on GPU.
+    case hipErrorLaunchFailure:
+        return "hipErrorLaunchFailure: illegal instruction or Halide assertion failure inside kernel";
+    case hipErrorNoBinaryForGpu:
+        return "hipErrorNoBinaryForGpu: code object does not match the device architecture";
+    default:
+        break;
+    }
+
+    if (hipGetErrorName != nullptr) {
+        const char *name = hipGetErrorName(err);
+        if (name) {
+            return name;
+        }
+    }
+
+    switch (err) {
+    case hipSuccess:
+        return "hipSuccess";
+    case hipErrorInvalidValue:
+        return "hipErrorInvalidValue";
+    case hipErrorOutOfMemory:
