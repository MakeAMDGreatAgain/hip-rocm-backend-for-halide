diff --git a/src/runtime/HalideRuntimeHIP.h b/src/runtime/HalideRuntimeHIP.h
new file mode 100644
index 0000000..bed80a8
--- /dev/null
+++ b/src/runtime/HalideRuntimeHIP.h
@@ -0,0 +1,116 @@
+#ifndef HALIDE_HALIDERUNTIMEHIP_H
+#define HALIDE_HALIDERUNTIMEHIP_H
+
+// Don't include HalideRuntime.h if the contents of it were already pasted into a generated header above this one
+#ifndef HALIDE_HALIDERUNTIME_H
+
+#include "HalideRuntime.h"
+
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** \file
+ *  Routines specific to the Halide HIP (AMD ROCm) runtime. This is the HIP
+ *  counterpart of HalideRuntimeCuda.h.
+ */
+
+#define HALIDE_RUNTIME_HIP
+
+extern const struct halide_device_interface_t *halide_hip_device_interface();
+
+/** These are forward declared here to allow clients to override the
+ *  Halide HIP runtime. Do not call them. */
+// @{
+extern int halide_hip_initialize_kernels(void *user_context, void **state_ptr,
+                                         const char *src, int size);
+extern int halide_hip_run(void *user_context,
+                          void *state_ptr,
+                          const char *entry_name,
+                          int blocksX, int blocksY, int blocksZ,
+                          int threadsX, int threadsY, int threadsZ,
+                          int shared_mem_bytes,
+                          size_t arg_sizes[],
+                          void *args[],
+                          int8_t arg_is_buffer[]);
+extern void halide_hip_finalize_kernels(void *user_context, void *state_ptr);
+// @}
+
+/** Set the underlying HIP device pointer for a buffer. The device
+ * pointer should be allocated using hipMalloc or similar and must
+ * have an extent large enough to cover that specified by the
+ * halide_buffer_t extent fields. The dev field of the halide_buffer_t
+ * must be NULL when this routine is called. This call can fail due to
+ * being passed an invalid device pointer. The device and host dirty
+ * bits are left unmodified. */
+extern int halide_hip_wrap_device_ptr(void *user_context, struct halide_buffer_t *buf, uint64_t device_ptr);
+
+/** Disconnect this halide_buffer_t from the device pointer it was
+ * previously wrapped around. Should only be called for a
+ * halide_buffer_t that halide_hip_wrap_device_ptr was previously
+ * called on. The device field of the halide_buffer_t will be NULL on
+ * return.
+ */
+extern int halide_hip_detach_device_ptr(void *user_context, struct halide_buffer_t *buf);
+
+/** Return the underlying device pointer for a halide_buffer_t. This buffer
+ *  must be valid on a HIP device, or not have any associated device
+ *  memory. If there is no device memory (dev field is NULL), this
+ *  returns 0.
+ */
+extern uintptr_t halide_hip_get_device_ptr(void *user_context, struct halide_buffer_t *buf);
+
+/** Release any currently-unused device allocations back to the HIP
+ * runtime. See halide_reuse_device_allocations. */
+extern int halide_hip_release_unused_device_allocations(void *user_context);
+
+/** Report the architecture of the HIP device Halide would use, in a form
+ * that Target.cpp maps to a hip_gfx* feature. Unlike CUDA there is no
+ * numeric compute capability on AMD GPUs; the "gfxNNNN" ISA name is encoded
+ * as:
+ *
+ *   major = the gfx generation, i.e. the decimal value of all but the last
+ *           two characters of the gfx id (9, 10, 11, 12, ...)
+ *   minor = the last two characters of the gfx id read as HEX digits
+ *           (gfx90a's trailing 'a' is a hex digit, hence hex)
+ *
+ *   gfx90a  -> (9,  0x0a)      gfx1030 -> (10, 0x30)
+ *   gfx942  -> (9,  0x42)      gfx1100 -> (11, 0x00)
+ *   gfx950  -> (9,  0x50)      gfx1151 -> (11, 0x51)
+ *                              gfx1201 -> (12, 0x01)
+ *
+ * The runtime derives this from the device's gcnArchName (e.g.
+ * "gfx942:sramecc+:xnack-", features ignored) when available, from the
+ * ROCm 5.x hipDeviceAttributeGcnArch integer otherwise, and as a last resort
+ * from hipDeviceComputeCapability (which only knows the ISA major/minor, so
+ * the stepping digit is reported as 0, e.g. gfx942 -> (9, 0x40); Target.cpp
+ * will then ask for HL_HIP_ARCH). Returns (0, 0) without error if no HIP
+ * runtime library can be found. */
+extern int halide_hip_compute_capability(void *user_context, int *major, int *minor);
+
+// HIP has no driver contexts: the "context" is the device ordinal that the
+// runtime selects with hipSetDevice. Streams are treated as void * to avoid
+// dependencies on HIP headers.
+typedef int (*halide_hip_acquire_context_t)(void *,  // user_context
+                                            int *,   // device ordinal out parameter (-1 if none and !create)
+                                            bool);   // should initialize HIP / select a device if not done yet
+typedef int (*halide_hip_release_context_t)(void * /* user_context */);
+typedef int (*halide_hip_get_stream_t)(void *,    // user_context
+                                       int,       // device ordinal
+                                       void **);  // hipStream_t out parameter (nullptr = null stream)
+
+/** Set custom methods to acquire and release the HIP device and streams.
+ *  Each returns the previously installed handler. */
+// @{
+extern halide_hip_acquire_context_t halide_set_hip_acquire_context(halide_hip_acquire_context_t handler);
+extern halide_hip_release_context_t halide_set_hip_release_context(halide_hip_release_context_t handler);
+extern halide_hip_get_stream_t halide_set_hip_get_stream(halide_hip_get_stream_t handler);
+// @}
+
+#ifdef __cplusplus
+}  // End extern "C"
+#endif
+
+#endif  // HALIDE_HALIDERUNTIMEHIP_H
diff --git a/src/runtime/hip.cpp b/src/runtime/hip.cpp
new file mode 100644
index 0000000..1d7dd06
--- /dev/null
+++ b/src/runtime/hip.cpp
@@ -0,0 +1,1837 @@
+// HIP (AMD ROCm) runtime for Halide. This file is a section-by-section mirror
+// of cuda.cpp; when in doubt about a code path, look at the same-named
+// function there. Intentional differences from cuda.cpp:
+//
+//  * No driver contexts. HIP's notion of a "current device" is a per-thread
+//    device ordinal set with hipSetDevice (the analogue of cuCtxPushCurrent).
+//    Halide's "context" is therefore the device ordinal: the acquire/release
+//    hooks hand out an int, the RAII Context does hipSetDevice/restore, and
+//    the compilation cache is keyed on the ordinal (encoded as a void *,
+//    because GPUCompilationCache needs a pointer-like key).
+//  * Kernel arguments are not packed by hand. Exactly like cuLaunchKernel,
+//    hipModuleLaunchKernel packs `kernelParams` itself using the code object's
+//    .args metadata (offset/size per argument), so buffer arguments are
+//    translated to a pointer-to-device-handle and everything else is passed
+//    through. HL_HIP_PACK_KERNARGS=1 switches to the alternative `extra`
+//    (HIP_LAUNCH_PARAM_BUFFER_POINTER) path for diagnosing kernarg ABI issues.
+//  * One library provides everything (libamdhip64.so.N / amdhip64_N.dll);
+//    HL_HIP_LIB=<path> overrides the search list.
+//  * hipDeviceptr_t is a void *, stored in halide_buffer_t::device as uint64_t.
+//  * halide_hip_compute_capability reports the gfx ISA id (see
+//    HalideRuntimeHIP.h for the encoding) derived from gcnArchName, since
+//    AMD GPUs have no numeric compute capability.
+//  * hipDrvMemcpy3D[Async] is used for strided copies of up to three
+//    dimensions when it is available (HL_HIP_DISABLE_MEMCPY3D=1 forces the
+//    recursive 1-D path that cuda.cpp uses unconditionally).
+//  * halide_hip_device_release does not call hipDeviceReset (that would tear
+//    down every allocation of every HIP user in the process); it synchronizes,
+//    frees Halide's pool and modules, and forgets the selected device.
+
+#include "HalideRuntimeHIP.h"
+#include "device_buffer_utils.h"
+#include "device_interface.h"
+#include "gpu_context_common.h"
+#include "mini_hip.h"
+#include "printer.h"
+#include "scoped_mutex_lock.h"
+#include "scoped_spin_lock.h"
+
+namespace Halide {
+namespace Runtime {
+namespace Internal {
+namespace Hip {
+
+// Define the function pointers for the HIP API.
+
+// clang-format off
+#define HIP_FN(ret, fn, args)             WEAK ret(HIPAPI *fn) args;  // NOLINT(bugprone-macro-parentheses)
+#define HIP_FN_OPTIONAL(ret, fn, args)    WEAK ret(HIPAPI *fn) args;  // NOLINT(bugprone-macro-parentheses)
+#include "hip_functions.h"
+#undef HIP_FN
+#undef HIP_FN_OPTIONAL
+// clang-format on
+
+// The default implementation of halide_hip_get_symbol attempts to load
+// the HIP shared library/DLL, and then get the symbol from it.
+WEAK void *lib_hip = nullptr;
+volatile ScopedSpinLock::AtomicFlag WEAK lib_hip_lock = 0;
+
+extern "C" WEAK void *halide_hip_get_symbol(void *user_context, const char *name) {
+    // Only try to load the library if we can't already get the symbol
+    // from the library. Even if the library is nullptr, the symbols may
+    // already be available in the process.
+    void *symbol = halide_get_library_symbol(lib_hip, name);
+    if (symbol) {
+        return symbol;
+    }
+
+    // HL_HIP_LIB=<path or soname> takes precedence over the built-in list.
+    const char *env_libname = getenv("HL_HIP_LIB");
+    if (env_libname) {
+        lib_hip = halide_load_library(env_libname);
+        if (lib_hip) {
+            debug(user_context) << "    Loaded HIP runtime library (HL_HIP_LIB): " << env_libname << "\n";
+        } else {
+            debug(user_context) << "    Missing HIP runtime library (HL_HIP_LIB): " << env_libname << "\n";
+        }
+    }
+
+    if (!lib_hip) {
+        // Versioned sonames first (ROCm 7.x ships libamdhip64.so.7, ROCm 6.x
+        // libamdhip64.so.6), then the unversioned dev symlink.
+        const char *lib_names[] = {
+#ifdef WINDOWS
+            "amdhip64_7.dll",
+            "amdhip64_6.dll",
+            "amdhip64.dll",
+#else
+            "libamdhip64.so.7",
+            "libamdhip64.so.6",
+            "libamdhip64.so",
+#endif
+        };
+        for (auto &lib_name : lib_names) {
+            lib_hip = halide_load_library(lib_name);
+            if (lib_hip) {
+                debug(user_context) << "    Loaded HIP runtime library: " << lib_name << "\n";
+                break;
+            } else {
+                debug(user_context) << "    Missing HIP runtime library: " << lib_name << "\n";
+            }
+        }
+    }
+
+    return halide_get_library_symbol(lib_hip, name);
+}
+
+template<typename T>
+ALWAYS_INLINE halide_error_code_t get_hip_symbol(void *user_context, const char *name, bool optional, T &fn) {
+    fn = (T)halide_hip_get_symbol(user_context, name);
+    if (!optional && !fn) {
+        error(user_context) << "HIP API not found: " << name
+                            << " (could not load libamdhip64 / amdhip64.dll; is ROCm installed? "
+                               "Set HL_HIP_LIB to an explicit path to override the search.)";
+        return halide_error_code_symbol_not_found;
+    }
+    return halide_error_code_success;
+}
+
+// Load the HIP shared object/dll and get the HIP API function pointers from it.
+WEAK int load_libhip(void *user_context) {
+    debug(user_context) << "    load_libhip (user_context: " << user_context << ")\n";
+    halide_abort_if_false(user_context, hipInit == nullptr);
+    halide_error_code_t result;
+
+    // clang-format off
+#define HIP_FN(ret, fn, args)          result = get_hip_symbol<ret(HIPAPI *) args>(user_context, #fn, false, fn); if (result) return result;  // NOLINT(bugprone-macro-parentheses)
+#define HIP_FN_OPTIONAL(ret, fn, args) result = get_hip_symbol<ret(HIPAPI *) args>(user_context, #fn, true, fn); if (result) return result;   // NOLINT(bugprone-macro-parentheses)
+#include "hip_functions.h"
+#undef HIP_FN
+#undef HIP_FN_OPTIONAL
+    // clang-format on
+    return halide_error_code_success;
+}
+
+// Call load_libhip() if the HIP library has not been loaded.
+// This function is thread safe.
+// Note that initialization might fail. The caller can detect such failure by checking whether hipInit is nullptr.
+WEAK int ensure_libhip_init(void *user_context) {
+    ScopedSpinLock spinlock(&lib_hip_lock);
+    if (!hipInit) {
+        return load_libhip(user_context);
+    }
+    return halide_error_code_success;
+}
+
+extern WEAK halide_device_interface_t hip_device_interface;
+
+WEAK const char *get_hip_error_name(hipError_t error);
+WEAK int create_hip_context(void *user_context, int *device);
+WEAK int get_hip_arch(void *user_context, int device, int *major, int *minor);
+
+template<typename... Args>
+int error_hip(void *user_context, hipError_t hip_error, const Args &...args) {
+    if (hip_error == hipSuccess) {
+        return halide_error_code_success;
+    }
+    error(user_context).append("HIP error: ", get_hip_error_name(hip_error), " ", args...);
+    return halide_error_code_gpu_device_error;
+}
+
+// The device ordinal this module has selected, with weak linkage. This is
+// the HIP analogue of cuda.cpp's `context`. -1 means "not initialized".
+WEAK int context_device = -1;
+// This lock protects the above variable.
+WEAK halide_mutex context_lock;
+
+// GPUCompilationCache wants a pointer-like key (release_all() passes
+// nullptr for "any context"), so the device ordinal is encoded as
+// (void *)(device + 1); the +1 keeps device 0 distinct from "no context".
+ALWAYS_INLINE void *device_cache_key(int device) {
+    return (void *)(uintptr_t)(device + 1);
+}
+
+// A free list, used when allocations are being cached.
+WEAK struct FreeListItem {
+    hipDeviceptr_t ptr;
+    int device;
+    hipStream_t stream;
+    size_t size;
+    FreeListItem *next;
+} *free_list = nullptr;
+WEAK halide_mutex free_list_lock;
+
+// Cached environment switches (-1 = not read yet).
+WEAK int env_pack_kernargs = -1;
+WEAK int env_disable_memcpy3d = -1;
+
+ALWAYS_INLINE bool env_flag_set(int &cache, const char *name) {
+    if (cache < 0) {
+        const char *v = getenv(name);
+        cache = (v && v[0] != 0 && v[0] != '0') ? 1 : 0;
+    }
+    return cache != 0;
+}
+
+}  // namespace Hip
+}  // namespace Internal
+}  // namespace Runtime
+}  // namespace Halide
+
+using namespace Halide::Runtime::Internal;
+using namespace Halide::Runtime::Internal::Hip;
+
+extern "C" {
+
+// The default implementation of halide_hip_acquire_context uses the global
+// device ordinal above, and serializes access with a mutex.
+// Overriding implementations of acquire/release must implement the following
+// behavior:
+// - halide_hip_acquire_context should always store a valid device ordinal in
+//   *device (or -1 when create == false and nothing is initialized), or
+//   return an error code.
+// - A call to halide_hip_acquire_context is followed by a matching call to
+//   halide_hip_release_context. halide_hip_acquire_context should block while a
+//   previous call (if any) has not yet been released via halide_hip_release_context.
+WEAK int halide_default_hip_acquire_context(void *user_context, int *device, bool create = true) {
+    halide_abort_if_false(user_context, device != nullptr);
+
+    // Note that this check of the device is *not* locked with respect to
+    // device_release, so we may get a device that's in the process of
+    // being released. Things will go badly in general if you call
+    // device_release while other Halide code is running though.
+    int local_val = context_device;
+    if (local_val < 0) {
+        if (!create) {
+            *device = -1;
+            return halide_error_code_success;
+        }
+
+        {
+            ScopedMutexLock spinlock(&context_lock);
+            local_val = context_device;
+            if (local_val < 0) {
+                if (auto result = create_hip_context(user_context, &local_val);
+                    result != halide_error_code_success) {
+                    return result;
+                }
+            }
+            // create_hip_context cannot access the "context_device" global,
+            // so a plain store is fine here (see cuda.cpp for the reasoning).
+            context_device = local_val;
+        }  // spinlock
+    }
+
+    *device = local_val;
+    return halide_error_code_success;
+}
+
+WEAK int halide_default_hip_release_context(void *user_context) {
+    return halide_error_code_success;
+}
+
+// Return the stream to use for executing kernels and synchronization. Default
+// is to use the null stream (nullptr). The device is passed in for
+// convenience, but any sort of scoping must be handled by that of the
+// halide_hip_acquire_context/halide_hip_release_context pair, not this call.
+WEAK int halide_default_hip_get_stream(void *user_context, int device, hipStream_t *stream) {
+    *stream = nullptr;
+    return halide_error_code_success;
+}
+
+}  // extern "C"
+
+namespace Halide {
+namespace Runtime {
+namespace Internal {
+namespace HIP {
+
+WEAK halide_hip_acquire_context_t acquire_context = (halide_hip_acquire_context_t)halide_default_hip_acquire_context;
+WEAK halide_hip_release_context_t release_context = (halide_hip_release_context_t)halide_default_hip_release_context;
+WEAK halide_hip_get_stream_t get_stream = (halide_hip_get_stream_t)halide_default_hip_get_stream;
+
+}  // namespace HIP
+}  // namespace Internal
+}  // namespace Runtime
+}  // namespace Halide
+
+extern "C" {
+
+WEAK int halide_hip_acquire_context(void *user_context, int *device, bool create = true) {
+    return HIP::acquire_context(user_context, device, create);
+}
+
+WEAK halide_hip_acquire_context_t halide_set_hip_acquire_context(halide_hip_acquire_context_t handler) {
+    halide_hip_acquire_context_t result = HIP::acquire_context;
+    HIP::acquire_context = handler;
+    return result;
+}
+
+WEAK int halide_hip_release_context(void *user_context) {
+    return HIP::release_context(user_context);
+}
+
+WEAK halide_hip_release_context_t halide_set_hip_release_context(halide_hip_release_context_t handler) {
+    halide_hip_release_context_t result = HIP::release_context;
+    HIP::release_context = handler;
+    return result;
+}
+
+WEAK int halide_hip_get_stream(void *user_context, int device, hipStream_t *stream) {
+    return HIP::get_stream(user_context, device, (void **)stream);
+}
+
+WEAK halide_hip_get_stream_t halide_set_hip_get_stream(halide_hip_get_stream_t handler) {
+    halide_hip_get_stream_t result = HIP::get_stream;
+    HIP::get_stream = handler;
+    return result;
+}
+}
+
+namespace Halide {
+namespace Runtime {
+namespace Internal {
+namespace Hip {
+
+// Helper object to acquire and release the HIP device. The HIP equivalent of
+// cuCtxPushCurrent/cuCtxPopCurrent is hipSetDevice on entry and restoring the
+// thread's previous device on exit.
+class Context {
+    void *const user_context;
+    int status = halide_error_code_success;  // must always be a valid halide_error_code_t value
+    int previous_device = -1;
+    bool device_changed = false;
+
+public:
+    int device = -1;
+
+    // Constructor sets 'status' if any error occurs.
+    ALWAYS_INLINE explicit Context(void *user_context)
+        : user_context(user_context) {
+#ifdef DEBUG_RUNTIME
+        halide_start_clock(user_context);
+#endif
+        status = halide_hip_acquire_context(user_context, &device);
+        if (status) {
+            return;
+        }
+
+        // The default acquire_context loads libamdhip64 as a
+        // side-effect. However, if acquire_context has been
+        // overridden, we may still need to load it.
+        status = ensure_libhip_init(user_context);
+        if (status) {
+            return;
+        }
+
+        halide_abort_if_false(user_context, device >= 0);
+        halide_abort_if_false(user_context, hipInit != nullptr);
+
+        if (hipGetDevice(&previous_device) != hipSuccess) {
+            previous_device = -1;
+        }
+        if (previous_device != device) {
+            status = error_hip(user_context, hipSetDevice(device), "hipSetDevice failed");
+            device_changed = (status == halide_error_code_success);
+        }
+    }
+
+    ALWAYS_INLINE ~Context() {
+        if (status == halide_error_code_success && device_changed && previous_device >= 0) {
+            hipSetDevice(previous_device);
+        }
+
+        (void)halide_hip_release_context(user_context);  // ignore error
+    }
+
+    ALWAYS_INLINE int error() const {
+        return status;
+    }
+
+    // Key for the compilation cache.
+    ALWAYS_INLINE void *cache_key() const {
+        return device_cache_key(device);
+    }
+
+    Context(const Context &) = delete;
+    Context &operator=(const Context &) = delete;
+    Context(Context &&) = delete;
+    Context &operator=(Context &&) = delete;
+};
+
+WEAK Halide::Internal::GPUCompilationCache<void *, hipModule_t> compilation_cache;
+
+WEAK int create_hip_context(void *user_context, int *device_out) {
+    // Initialize HIP
+    auto result = ensure_libhip_init(user_context);
+    if (result) {
+        return result;
+    }
+    if (!hipInit) {
+        return error_hip(user_context, hipErrorFileNotFound,
+                         "Could not find the HIP runtime library (libamdhip64 / amdhip64.dll)");
+    }
+
+    hipError_t err = hipInit(0);
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipInit failed");
+    }
+
+#ifdef DEBUG_RUNTIME
+    if (hipRuntimeGetVersion) {
+        int version = 0;
+        if (hipRuntimeGetVersion(&version) == hipSuccess) {
+            debug(user_context) << "    HIP runtime version " << version << "\n";
+        }
+    }
+#endif
+
+    // Make sure we have a device
+    int deviceCount = 0;
+    err = hipGetDeviceCount(&deviceCount);
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "hipGetDeviceCount failed");
+    }
+
+    if (deviceCount <= 0) {
+        return error_hip(user_context, hipErrorNoDevice, "No devices available");
+    }
+
+    int device = halide_get_gpu_device(user_context);
+    if (device == -1 && deviceCount == 1) {
+        device = 0;
+    } else if (device == -1) {
+        debug(user_context) << "HIP: Multiple HIP devices detected. Selecting the one with the most compute units.\n";
+        int best_core_count = 0;
+        for (int i = 0; i < deviceCount; i++) {
+            hipDevice_t dev;
+            hipError_t status = hipDeviceGet(&dev, i);
+            if (status != hipSuccess) {
+                debug(user_context) << "      Failed to get device " << i << "\n";
+                continue;
+            }
+            int core_count = 0;
+            status = hipDeviceGetAttribute(&core_count, hipDeviceAttributeMultiprocessorCount, dev);
+            debug(user_context) << "      Device " << i << " has " << core_count << " compute units\n";
+            if (status != hipSuccess) {
+                continue;
+            }
+            if (core_count >= best_core_count) {
+                device = i;
+                best_core_count = core_count;
+            }
+        }
+    }
+
+    if (device < 0 || device >= deviceCount) {
+        return error_hip(user_context, hipErrorInvalidDevice, "Requested HIP device ordinal (HL_GPU_DEVICE) is out of range");
+    }
+
+    // Get device
+    hipDevice_t dev;
+    err = hipDeviceGet(&dev, device);
+    if (err != hipSuccess) {
+        return error_hip(user_context, err, "Failed to get device");
+    }
+
+    debug(user_context) << "    Got device " << dev << "\n";
+
+// Dump device attributes
+#ifdef DEBUG_RUNTIME
+    {
+        char name[256];
+        name[0] = 0;
+        err = hipDeviceGetName(name, 256, dev);
+        debug(user_context) << "      " << name << "\n";
+
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, "hipDeviceGetName failed");
+        }
+
+        size_t memory = 0;
+        err = hipDeviceTotalMem(&memory, dev);
+        debug(user_context) << "      total memory: " << (int)(memory >> 20) << " MB\n";
+
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, "hipDeviceTotalMem failed");
+        }
+
+        // Declare variables for other state we want to query.
+        int max_threads_per_block = 0, warp_size = 0, num_cores = 0;
+        int max_block_size[] = {0, 0, 0};
+        int max_grid_size[] = {0, 0, 0};
+        int max_shared_mem = 0, max_constant_mem = 0;
+        int cc_major = 0, cc_minor = 0;
+
+        struct {
+            int *dst;
+            hipDeviceAttribute_t attr;
+        } attrs[] = {
+            {&max_threads_per_block, hipDeviceAttributeMaxThreadsPerBlock},
+            {&warp_size, hipDeviceAttributeWarpSize},
+            {&num_cores, hipDeviceAttributeMultiprocessorCount},
+            {&max_block_size[0], hipDeviceAttributeMaxBlockDimX},
+            {&max_block_size[1], hipDeviceAttributeMaxBlockDimY},
+            {&max_block_size[2], hipDeviceAttributeMaxBlockDimZ},
+            {&max_grid_size[0], hipDeviceAttributeMaxGridDimX},
+            {&max_grid_size[1], hipDeviceAttributeMaxGridDimY},
+            {&max_grid_size[2], hipDeviceAttributeMaxGridDimZ},
+            {&max_shared_mem, hipDeviceAttributeMaxSharedMemoryPerBlock},
+            {&max_constant_mem, hipDeviceAttributeTotalConstantMemory},
+            {&cc_major, hipDeviceAttributeComputeCapabilityMajor},
+            {&cc_minor, hipDeviceAttributeComputeCapabilityMinor},
+            {nullptr, hipDeviceAttributeCudaCompatibleBegin}};
+
+        // Do all the queries.
+        for (int i = 0; attrs[i].dst; i++) {
+            err = hipDeviceGetAttribute(attrs[i].dst, attrs[i].attr, dev);
+            if (err != hipSuccess) {
+                return error_hip(user_context, err, "hipDeviceGetAttribute failed for attribute ", (int)attrs[i].attr);
+            }
+        }
+
+        int arch_major = 0, arch_minor = 0;
+        (void)get_hip_arch(user_context, device, &arch_major, &arch_minor);
+
+        debug(user_context)
+            << "      max threads per block: " << max_threads_per_block << "\n"
+            << "      wavefront size: " << warp_size << "\n"
+            << "      max block size: " << max_block_size[0]
+            << " " << max_block_size[1] << " " << max_block_size[2] << "\n"
+            << "      max grid size: " << max_grid_size[0]
+            << " " << max_grid_size[1] << " " << max_grid_size[2] << "\n"
+            << "      max shared memory (LDS) per block: " << max_shared_mem << "\n"
+            << "      max constant memory: " << max_constant_mem << "\n"
+            << "      isa version " << cc_major << "." << cc_minor
+            << " (halide_hip_compute_capability encoding: major " << arch_major
+            << ", minor " << arch_minor << " decimal)\n"
+            << "      compute units: " << num_cores << "\n";
+    }
+#endif
+
+    // There is no context to create: the device is selected per thread by
+    // Context (hipSetDevice). Just hand back the ordinal.
+    *device_out = device;
+    return halide_error_code_success;
+}
+
+// This feature may be useful during HIP backend or runtime
+// development. It does not seem to find many errors in general Halide
+// use (and hipPointerGetAttributes is optional in the loaded library).
+#define ENABLE_POINTER_VALIDATION 0
+
+WEAK int validate_device_pointer(void *user_context, halide_buffer_t *buf, size_t size = 0) {
+#if !ENABLE_POINTER_VALIDATION
+    return halide_error_code_success;
+#else
+    if (buf->device != 0 && hipPointerGetAttributes != nullptr) {
+        hipDeviceptr_t dev_ptr = (hipDeviceptr_t)(uintptr_t)buf->device;
+
+        // hipPointerAttribute_t is ~40 bytes in every ROCm release; use an
+        // oversized, zeroed, opaque buffer and only look at the error code.
+        uint64_t attributes[64];
+        memset(attributes, 0, sizeof(attributes));
+        hipError_t err = hipPointerGetAttributes((hipPointerAttribute_t *)attributes, (const void *)dev_ptr);
+        if (err != hipSuccess) {
+            return error_hip(user_context, err, "Bad device pointer ", (void *)dev_ptr);
+        }
+    }
+    return halide_error_code_success;
+#endif
+}
+
+WEAK hipModule_t compile_kernel(void *user_context, const char *src, int size) {
+    debug(user_context) << "HIP: compile_kernel hipModuleLoadData " << (void *)src << ", " << size << " -> ";
+
+    // `src` is a complete AMDGPU code object (ET_DYN ELF produced by lld) or a
+    // clang offload bundle; hipModuleLoadData accepts either and needs no
+    // JIT options.
+    hipModule_t loaded_module = nullptr;
+    hipError_t err = hipModuleLoadData(&loaded_module, src);
+
+    if (err != hipSuccess) {
+        if (err == hipErrorNoBinaryForGpu) {
+            error(user_context) << "HIP: hipModuleLoadData failed: " << get_hip_error_name(err)
+                                << ". The code object was built for a GPU architecture that does not match "
+                                   "the selected device (e.g. compiled for hip_gfx942 but running on gfx1100). "
+                                   "Set HL_HIP_ARCH=gfxNNNN (or the matching hip_gfx* target feature) to the "
+                                   "device's architecture, or select a different device with HL_GPU_DEVICE.";
+        } else if (err == hipErrorInvalidImage || err == hipErrorInvalidKernelFile) {
+            error(user_context) << "HIP: hipModuleLoadData failed: " << get_hip_error_name(err)
+                                << ". The embedded kernel image is not a code object this ROCm runtime accepts. "
+                                   "Check that it is an lld-linked ET_DYN ELF for amdgcn-amd-amdhsa and that its "
+                                   "code-object version (HL_HIP_CODE_OBJECT_VERSION, default 5) is supported by "
+                                   "the installed ROCm.";
+        } else {
+            error(user_context) << "HIP: hipModuleLoadData failed: "
+                                << get_hip_error_name(err);
+        }
+        return nullptr;
+    } else {
+        debug(user_context) << (void *)(loaded_module) << "\n";
+    }
+    return loaded_module;
+}
