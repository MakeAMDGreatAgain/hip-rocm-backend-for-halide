+// Note that this header intentionally does not use include
+// guards. The intended usage of this file is to define the meaning of
+// the HIP_FN macros, and then include this file, sometimes
+// repeatedly within the same compilation unit. (Mirror of cuda_functions.h.)
+//
+// Prototypes were transcribed verbatim from
+// https://raw.githubusercontent.com/ROCm/HIP/develop/include/hip/hip_runtime_api.h
+// (2026-09-04). All of them live in the single HIP runtime library
+// (libamdhip64.so / amdhip64.dll); there is no separate "driver" library.
+
+#ifndef HIP_FN
+#define HIP_FN(ret, fn, args)
+#endif
+#ifndef HIP_FN_OPTIONAL
+#define HIP_FN_OPTIONAL(ret, fn, args)
+#endif
+
+// Initialization / device enumeration
+HIP_FN(hipError_t, hipInit, (unsigned int flags));
+HIP_FN(hipError_t, hipGetDeviceCount, (int *count));
+HIP_FN(hipError_t, hipDeviceGet, (hipDevice_t * device, int ordinal));
+HIP_FN(hipError_t, hipDeviceGetAttribute, (int *pi, hipDeviceAttribute_t attr, int deviceId));
+HIP_FN(hipError_t, hipDeviceGetName, (char *name, int len, hipDevice_t device));
+HIP_FN(hipError_t, hipDeviceComputeCapability, (int *major, int *minor, hipDevice_t device));
+HIP_FN(hipError_t, hipDeviceTotalMem, (size_t *bytes, hipDevice_t device));
+HIP_FN(hipError_t, hipSetDevice, (int deviceId));
+HIP_FN(hipError_t, hipGetDevice, (int *deviceId));
+HIP_FN(hipError_t, hipDeviceSynchronize, ());
+
+// Modules / kernels
+HIP_FN(hipError_t, hipModuleLoadData, (hipModule_t * module, const void *image));
+HIP_FN(hipError_t, hipModuleUnload, (hipModule_t module));
+HIP_FN(hipError_t, hipModuleGetFunction, (hipFunction_t * function, hipModule_t module, const char *kname));
+HIP_FN(hipError_t, hipModuleLaunchKernel, (hipFunction_t f, unsigned int gridDimX, unsigned int gridDimY, unsigned int gridDimZ, unsigned int blockDimX, unsigned int blockDimY, unsigned int blockDimZ, unsigned int sharedMemBytes, hipStream_t stream, void **kernelParams, void **extra));
+
+// Memory
+HIP_FN(hipError_t, hipMalloc, (void **ptr, size_t size));
+HIP_FN(hipError_t, hipFree, (void *ptr));
+HIP_FN(hipError_t, hipMemcpyHtoD, (hipDeviceptr_t dst, const void *src, size_t sizeBytes));
+HIP_FN(hipError_t, hipMemcpyDtoH, (void *dst, hipDeviceptr_t src, size_t sizeBytes));
+HIP_FN(hipError_t, hipMemcpyDtoD, (hipDeviceptr_t dst, hipDeviceptr_t src, size_t sizeBytes));
+HIP_FN(hipError_t, hipMemcpyHtoDAsync, (hipDeviceptr_t dst, const void *src, size_t sizeBytes, hipStream_t stream));
+HIP_FN(hipError_t, hipMemcpyDtoHAsync, (void *dst, hipDeviceptr_t src, size_t sizeBytes, hipStream_t stream));
+HIP_FN(hipError_t, hipMemcpyDtoDAsync, (hipDeviceptr_t dst, hipDeviceptr_t src, size_t sizeBytes, hipStream_t stream));
+
+// Streams
+HIP_FN(hipError_t, hipStreamSynchronize, (hipStream_t stream));
+
+// Optional: used when present, with fallbacks otherwise.
+HIP_FN_OPTIONAL(const char *, hipGetErrorName, (hipError_t hip_error));
+HIP_FN_OPTIONAL(hipError_t, hipDrvMemcpy3D, (const HIP_MEMCPY3D *pCopy));
+HIP_FN_OPTIONAL(hipError_t, hipDrvMemcpy3DAsync, (const HIP_MEMCPY3D *pCopy, hipStream_t stream));
+HIP_FN_OPTIONAL(hipError_t, hipMemGetInfo, (size_t *free_bytes, size_t *total_bytes));
+// hipPointerAttribute_t is treated as opaque (its layout differs between ROCm 5
+// and 6); hip.cpp only ever looks at the returned error code.
+HIP_FN_OPTIONAL(hipError_t, hipPointerGetAttributes, (hipPointerAttribute_t * attributes, const void *ptr));
+// Device properties are only used to read gcnArchName (see get_hip_arch in
+// hip.cpp). ROCm >= 6.0 exports the versioned symbol (`#define
+// hipGetDeviceProperties hipGetDevicePropertiesR0600` in the public header)
+// and keeps the unversioned one as the ROCm 5 ABI; ROCm 5.x only has the
+// unversioned symbol. hipDeviceProp_t is treated as opaque.
+HIP_FN_OPTIONAL(hipError_t, hipGetDevicePropertiesR0600, (hipDeviceProp_t * prop, int deviceId));
+HIP_FN_OPTIONAL(hipError_t, hipGetDeviceProperties, (hipDeviceProp_t * prop, int deviceId));
+HIP_FN_OPTIONAL(hipError_t, hipRuntimeGetVersion, (int *runtimeVersion));
+
+#undef HIP_FN
+#undef HIP_FN_OPTIONAL
