+        auto shfl_down = [&](const Expr &delta, const Expr &cuda_clamp) {
+            if (hip) {
+                return Call::make(shuffle_type, "halide_amdgpu_shfl_down" + intrin_suffix,
+                                  {base_val, delta, warp_size}, Call::PureExtern);
+            }
+            return Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".down" + intrin_suffix,
+                              shfl_args({membermask, base_val, delta, cuda_clamp}), Call::PureExtern);
+        };
+        auto shfl_up = [&](const Expr &delta, const Expr &cuda_clamp) {
+            if (hip) {
+                return Call::make(shuffle_type, "halide_amdgpu_shfl_up" + intrin_suffix,
+                                  {base_val, delta, warp_size}, Call::PureExtern);
+            }
+            return Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".up" + intrin_suffix,
+                              shfl_args({membermask, base_val, delta, cuda_clamp}), Call::PureExtern);
+        };
+        auto shfl_idx = [&](const Expr &src_lane, const Expr &cuda_mask) {
+            if (hip) {
+                return Call::make(shuffle_type, "halide_amdgpu_shfl_idx" + intrin_suffix,
+                                  {base_val, src_lane, warp_size}, Call::PureExtern);
+            }
+            return Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".idx" + intrin_suffix,
+                              shfl_args({membermask, base_val, src_lane, cuda_mask}), Call::PureExtern);
+        };
+
+        // log2 of the widest warp this API supports: 5 for CUDA and wave32,
+        // 6 for wave64. Bounds the rotate pattern below.
+        int max_warp_bits = 0;
+        while ((1 << max_warp_bits) < wt.max_warp_size) {
+            max_warp_bits++;
         }
 
         Expr wild = Variable::make(Int(32), "*");
@@ -590,25 +717,21 @@ class LowerWarpShuffles : public IRMutator {
         lane = solve_expression(lane, this_lane_name).result;
 
         Expr shuffled;
-        Expr membermask = (int)0xffffffff;
         if (expr_match(this_lane + wild, lane, result)) {
             // We know that 0 <= lane + wild < warp_size by how we
             // constructed it, so we can just do a shuffle down.
-            Expr down = Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".down" + intrin_suffix,
-                                   shfl_args({membermask, base_val, result[0], 31}), Call::PureExtern);
+            Expr down = shfl_down(result[0], 31);
             shuffled = down;
         } else if (expr_match((this_lane + wild) % wild, lane, result) &&
                    (bits = is_const_power_of_two_integer(result[1])) &&
-                   *bits <= 5) {
+                   *bits <= max_warp_bits) {
             result[0] = simplify(result[0] % result[1], bounds);
             // Rotate. Mux a shuffle up and a shuffle down. Uses fewer
             // intermediate registers than using a general gather for
             // this.
             Expr mask = (1 << *bits) - 1;
-            Expr down = Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".down" + intrin_suffix,
-                                   shfl_args({membermask, base_val, result[0], mask}), Call::PureExtern);
-            Expr up = Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".up" + intrin_suffix,
-                                 shfl_args({membermask, base_val, (1 << *bits) - result[0], 0}), Call::PureExtern);
+            Expr down = shfl_down(result[0], mask);
+            Expr up = shfl_up((1 << *bits) - result[0], 0);
             Expr cond = (this_lane >= (1 << *bits) - result[0]);
             Expr equiv = select(cond, up, down);
             shuffled = simplify(equiv, bounds);
@@ -621,8 +744,7 @@ class LowerWarpShuffles : public IRMutator {
             // could hypothetically be used for boundary conditions.
             Expr mask = simplify(((31 & ~(warp_size - 1)) << 8) | 31);
             // The idx variant can do a general gather. Use it for all other cases.
-            shuffled = Call::make(shuffle_type, "llvm.nvvm.shfl" + sync_suffix + ".idx" + intrin_suffix,
-                                  shfl_args({membermask, base_val, lane, mask}), Call::PureExtern);
+            shuffled = shfl_idx(lane, mask);
         }
         // TODO: There are other forms, like butterfly and clamp, that
         // don't need to use the general gather
@@ -667,8 +789,8 @@ class LowerWarpShuffles : public IRMutator {
     }
 
 public:
