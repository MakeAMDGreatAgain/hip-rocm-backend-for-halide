         // https://docs.nvidia.com/cuda/volta-tuning-guide/index.html
         string sync_suffix = "";
-        if (cuda_cap >= 70) {
+        if (wt.cuda_cap >= 70) {
             sync_suffix = ".sync";
         }
 
         auto shfl_args = [&](const std::vector<Expr> &args) {
-            if (cuda_cap >= 70) {
+            if (wt.cuda_cap >= 70) {
                 return args;
             }
             return std::vector({args[1], args[2], args[3]});
