--- /dev/null
+++ b/test/correctness/hip_warp_shuffles.cpp
@@ -0,0 +1,135 @@
+#include "Halide.h"
+#include <stdio.h>
+
+// Lowering-only test for warp shuffles on the HIP (AMDGPU) backend. It
+// compiles pipelines that use gpu_lanes for gfx1100 (wave32) and gfx942
+// (wave64) targets and inspects the lowered IR through a custom lowering
+// pass, which runs after LowerWarpShuffles and before the kernels are handed
+// to the device code generator. No AMD hardware or HIP runtime is needed.
+
+using namespace Halide;
+using namespace Halide::Internal;
+
+namespace {
+
+// Counts the warp shuffle calls in the lowered IR.
+class CountShuffles : public IRMutator {
+    using IRMutator::visit;
+
+    Expr visit(const Call *op) override {
+        if (starts_with(op->name, "halide_amdgpu_shfl_")) {
+            amdgpu++;
+        } else if (starts_with(op->name, "llvm.nvvm.shfl")) {
+            nvvm++;
+        }
+        return IRMutator::visit(op);
+    }
+
+public:
+    int amdgpu = 0, nvvm = 0;
+};
+
+// A small convolution whose input lives in registers and is striped across
+// the lanes of a warp, so reading the neighbours needs warp shuffles. This
+// is the schedule from test/correctness/register_shuffle.cpp.
+Func make_pipeline(int lanes) {
+    Func f("f"), g("g");
+    Var x("x"), y("y"), xo("xo"), xi("xi"), yi("yi");
+
+    f(x, y) = cast<uint8_t>(x + y);
+    g(x, y) = f(x - 1, y) + f(x + 1, y);
+
+    g.gpu_tile(x, y, xi, yi, lanes, 2, TailStrategy::RoundUp)
+        .gpu_lanes(xi);
+
+    f.compute_root();
+
+    f.in(g)
+        .compute_at(g, yi)
+        .split(x, xo, xi, lanes, TailStrategy::RoundUp)
+        .gpu_lanes(xi)
+        .unroll(xo);
+
+    return g;
+}
+
+bool lower_and_count(int lanes, const std::string &target_string, int *amdgpu, int *nvvm) {
+    Target target(target_string);
+    Func g = make_pipeline(lanes);
+    CountShuffles counter;
+    g.add_custom_lowering_pass(&counter, nullptr);
+    g.compile_to_module(g.infer_arguments(), "hip_warp_shuffles", target);
+    *amdgpu = counter.amdgpu;
+    *nvvm = counter.nvvm;
+    return true;
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    if (!Target("host-hip-hip_gfx1100").supported()) {
+        printf("[SKIP] Halide was built without the AMDGPU backend.\n");
+        return 0;
+    }
+    if (!get_env_variable("HL_HIP_ARCH").empty()) {
+        printf("[SKIP] HL_HIP_ARCH overrides the hip_gfx* target features this test relies on.\n");
+        return 0;
+    }
+
+    struct Case {
+        int lanes;
+        const char *target;
+    } cases[] = {
+        // wave32 hardware, a full warp of lanes
+        {32, "host-hip-hip_gfx1100"},
+        // wave64 hardware, a full wavefront of lanes: more than CUDA allows
+        {64, "host-hip-hip_gfx942"},
+        // wave64 hardware with 32-lane loops (two Halide warps per wavefront)
+        {32, "host-hip-hip_gfx942"},
+    };
+
+    for (const Case &c : cases) {
+        int amdgpu = 0, nvvm = 0;
+        lower_and_count(c.lanes, c.target, &amdgpu, &nvvm);
+        printf("%s with %d lanes: %d halide_amdgpu_shfl_* calls, %d llvm.nvvm.shfl calls\n",
+               c.target, c.lanes, amdgpu, nvvm);
+        if (amdgpu == 0) {
+            printf("Expected the lowered IR to contain halide_amdgpu_shfl_* calls\n");
+            return 1;
+        }
+        if (nvvm != 0) {
+            printf("The lowered IR for a HIP kernel must not contain CUDA shuffle intrinsics\n");
+            return 1;
+        }
+    }
+
+#if HALIDE_WITH_EXCEPTIONS
+    if (exceptions_enabled()) {
+        // 64 lanes do not fit a wave32 wavefront.
+        bool threw = false;
+        try {
+            int amdgpu = 0, nvvm = 0;
+            lower_and_count(64, "host-hip-hip_gfx1100", &amdgpu, &nvvm);
+        } catch (const CompileError &e) {
+            threw = true;
+            std::string msg = e.what();
+            const char *expected = "HIP gpu lanes loop must have constant extent of at most 32";
+            if (msg.find(expected) == std::string::npos) {
+                printf("Unexpected error message:\n%s\nExpected it to contain:\n%s\n",
+                       msg.c_str(), expected);
+                return 1;
+            }
+            printf("64 lanes on hip_gfx1100 correctly rejected: %s", msg.c_str());
+        }
+        if (!threw) {
+            printf("Expected a compile error for 64 lanes on hip_gfx1100 (wave32)\n");
+            return 1;
+        }
+    } else {
+        printf("Exceptions disabled; skipping the wave32 overflow check (see test/error/hip_gpu_lanes_too_wide.cpp)\n");
+    }
+#endif
+
+    printf("Success!\n");
+    return 0;
+}
