+  %s24 = fdiv double %f22, %mp123
+  %z25 = fmul double %s24, %s24
+  %lp26 = call double @llvm.fma.f64(double 0x3FB642C8590B2164, double %z25, double 0x3FB8618618618618)
+  %lp27 = call double @llvm.fma.f64(double %lp26, double %z25, double 0x3FBAF286BCA1AF28)
+  %lp28 = call double @llvm.fma.f64(double %lp27, double %z25, double 0x3FBE1E1E1E1E1E1E)
+  %lp29 = call double @llvm.fma.f64(double %lp28, double %z25, double 0x3FC1111111111111)
+  %lp30 = call double @llvm.fma.f64(double %lp29, double %z25, double 0x3FC3B13B13B13B14)
+  %lp31 = call double @llvm.fma.f64(double %lp30, double %z25, double 0x3FC745D1745D1746)
+  %lp32 = call double @llvm.fma.f64(double %lp31, double %z25, double 0x3FCC71C71C71C71C)
+  %lp33 = call double @llvm.fma.f64(double %lp32, double %z25, double 0x3FD2492492492492)
+  %lp34 = call double @llvm.fma.f64(double %lp33, double %z25, double 0x3FD999999999999A)
+  %lp35 = call double @llvm.fma.f64(double %lp34, double %z25, double 0x3FE5555555555555)
+  %R36 = fmul double %z25, %lp35
+  %ff37 = fmul double %f22, %f22
+  %hfsq38 = fmul double %ff37, 0x3FE0000000000000
