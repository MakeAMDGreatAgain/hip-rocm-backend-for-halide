@@ -46,6 +47,81 @@ using std::vector;
 
 namespace {
 
+// The GPU API a kernel targets and the hardware warp (wavefront) width it
+// runs with. CUDA warps are 32 wide. AMD wavefronts are 64 wide on gfx9
+// (Vega/CDNA) and 32 wide on gfx10 and later (RDNA), which
+// CodeGen_AMDGPU_Dev compiles with +wavefrontsize32.
+struct WarpTarget {
+    DeviceAPI device_api = DeviceAPI::None;
+    // Largest gpu_lanes extent a kernel may use.
+    int max_warp_size = 32;
+    // CUDA only: compute capability lower bound (selects the .sync intrinsics).
+    int cuda_cap = 0;
+    // HIP only: the gfx name, for error messages.
+    string arch;
+};
+
+// The wavefront width CodeGen_AMDGPU_Dev compiles for. This parses the same
+// gfx name the codegen uses (a hip_gfx* feature or HL_HIP_ARCH, via
+// Target::get_hip_arch_string()) with the same rule as its gfx_generation(),
+// so the two cannot disagree.
+int hip_wavefront_size(const string &arch) {
+    int generation = 0;
+    if (starts_with(arch, "gfx")) {
+        // gfx900, gfx90a, gfx942 (three characters after "gfx") name
+        // generations 6-9; gfx1030, gfx1100, gfx1201 (four) name 10 and up;
+        // gfx9-generic / gfx10-3-generic carry the generation on its own.
+        string token;
+        for (size_t i = 3; i < arch.size() && std::isalnum((unsigned char)arch[i]); i++) {
+            token += arch[i];
+        }
+        string digits;
+        for (char c : token) {
+            if (!std::isdigit((unsigned char)c)) {
+                break;
+            }
+            digits += c;
+        }
+        if (!digits.empty()) {
+            if (token.size() >= 4) {
+                generation = std::stoi(digits.substr(0, 2));
+            } else if (token.size() == 3) {
+                generation = digits[0] - '0';
+            } else {
+                generation = std::stoi(digits);
+            }
+        }
+    }
+    if (generation == 0) {
+        user_warning << "Could not determine the wavefront size of HIP architecture \""
+                     << arch << "\"; assuming 64 lanes when lowering gpu_lanes loops. "
+                     << "Set a hip_gfx* target feature or HL_HIP_ARCH.\n";
+        return 64;
+    }
+    return generation >= 10 ? 32 : 64;
+}
+
+WarpTarget warp_target_for(DeviceAPI api, const Target &t) {
+    WarpTarget wt;
+    wt.device_api = api;
+    if (api == DeviceAPI::HIP) {
+        wt.arch = t.get_hip_arch_string();
+        wt.max_warp_size = hip_wavefront_size(wt.arch);
+    } else {
+        internal_assert(api == DeviceAPI::CUDA);
+        wt.max_warp_size = 32;
+        wt.cuda_cap = t.get_cuda_capability_lower_bound();
+    }
+    return wt;
+}
+
+// The names of the warp shuffle calls emitted below, matched by
+// HoistWarpShufflesFromSingleIfStmt.
+bool is_warp_shuffle_call(const string &name) {
+    return starts_with(name, "llvm.nvvm.shfl.") ||
+           starts_with(name, "halide_amdgpu_shfl_");
+}
