+
+; ---------------------------------------------------------------------------
+; 5. Warp shuffles
+; ---------------------------------------------------------------------------
+;
+; LowerWarpShuffles emits these for DeviceAPI::HIP kernels in place of the
+; llvm.nvvm.shfl.sync.* intrinsics it uses for CUDA. They implement the
+; __shfl_sync semantics minus the member mask:
+;
+;   halide_amdgpu_shfl_idx_T (val, src_lane, width)
+;       reads val from lane (lane & ~(width-1)) | (src_lane & (width-1))
+;   halide_amdgpu_shfl_down_T(val, delta, width)
+;       reads val from lane + delta, or returns val when
+;       (lane & (width-1)) + delta >= width
+;   halide_amdgpu_shfl_up_T  (val, delta, width)
+;       reads val from lane - delta, or returns val when
+;       (lane & (width-1)) < delta
+;
+; width must be a power of two no larger than the wavefront (64 on gfx9, 32
+; on gfx10+, which CodeGen_AMDGPU_Dev compiles with +wavefrontsize32);
+; LowerWarpShuffles enforces that. The lane index is read with
+; mbcnt.lo/hi, which counts the whole wave on both wave sizes (mbcnt.hi is
+; the identity on wave32), and the cross-lane read is ds_bpermute_b32, which
+; addresses lanes in bytes and operates on the whole wave on both sizes. As
+; with CUDA, the source lane must be active: LowerWarpShuffles hoists the
+; calls out of conditionals (HoistWarpShuffles).
+
+declare i32 @llvm.amdgcn.mbcnt.lo(i32, i32) nounwind readnone
+declare i32 @llvm.amdgcn.mbcnt.hi(i32, i32) nounwind readnone
+declare i32 @llvm.amdgcn.ds.bpermute(i32, i32) nounwind readnone convergent
+
+; Index of this thread within its wavefront.
+define weak_odr i32 @halide_amdgpu_lane_id() nounwind readnone alwaysinline {
+entry:
+  %lo = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
+  %lane = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %lo)
+  ret i32 %lane
+}
+
+define weak_odr i32 @halide_amdgpu_shfl_idx_i32(i32 %val, i32 %src_lane, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %lane = call i32 @halide_amdgpu_lane_id()
+  %wm1 = sub i32 %width, 1
+  %nwm1 = xor i32 %wm1, -1
+  %seg = and i32 %lane, %nwm1
+  %off = and i32 %src_lane, %wm1
+  %src = or i32 %seg, %off
+  %addr = shl i32 %src, 2
+  %r = call i32 @llvm.amdgcn.ds.bpermute(i32 %addr, i32 %val)
+  ret i32 %r
+}
+
+define weak_odr i32 @halide_amdgpu_shfl_down_i32(i32 %val, i32 %delta, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %lane = call i32 @halide_amdgpu_lane_id()
+  %wm1 = sub i32 %width, 1
+  %inseg = and i32 %lane, %wm1
+  %sum = add i32 %inseg, %delta
+  %ok = icmp ult i32 %sum, %width
+  %cand = add i32 %lane, %delta
+  %src = select i1 %ok, i32 %cand, i32 %lane
+  %addr = shl i32 %src, 2
+  %r = call i32 @llvm.amdgcn.ds.bpermute(i32 %addr, i32 %val)
+  ret i32 %r
+}
+
+define weak_odr i32 @halide_amdgpu_shfl_up_i32(i32 %val, i32 %delta, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %lane = call i32 @halide_amdgpu_lane_id()
+  %wm1 = sub i32 %width, 1
+  %inseg = and i32 %lane, %wm1
+  %ok = icmp uge i32 %inseg, %delta
+  %cand = sub i32 %lane, %delta
+  %src = select i1 %ok, i32 %cand, i32 %lane
+  %addr = shl i32 %src, 2
+  %r = call i32 @llvm.amdgcn.ds.bpermute(i32 %addr, i32 %val)
+  ret i32 %r
+}
+
+define weak_odr float @halide_amdgpu_shfl_idx_f32(float %val, i32 %src_lane, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %bits = bitcast float %val to i32
+  %r = call i32 @halide_amdgpu_shfl_idx_i32(i32 %bits, i32 %src_lane, i32 %width)
+  %f = bitcast i32 %r to float
+  ret float %f
+}
+
+define weak_odr float @halide_amdgpu_shfl_down_f32(float %val, i32 %delta, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %bits = bitcast float %val to i32
+  %r = call i32 @halide_amdgpu_shfl_down_i32(i32 %bits, i32 %delta, i32 %width)
+  %f = bitcast i32 %r to float
+  ret float %f
+}
+
+define weak_odr float @halide_amdgpu_shfl_up_f32(float %val, i32 %delta, i32 %width) nounwind readnone convergent alwaysinline {
+entry:
+  %bits = bitcast float %val to i32
+  %r = call i32 @halide_amdgpu_shfl_up_i32(i32 %bits, i32 %delta, i32 %width)
+  %f = bitcast i32 %r to float
+  ret float %f
+}
