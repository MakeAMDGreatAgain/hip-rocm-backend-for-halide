+  %log45 = call double @llvm.fma.f64(double %ef43, double 0x3FE62E42FEFA39EF, double %l144)
+  %isinf46 = fcmp oeq double %t9, 0x7FF0000000000000
+  %log47 = select i1 %isinf46, double %t9, double %log45
+  %ratio48 = fdiv double %u8, %tm110
+  %l1p49 = fmul double %log47, %ratio48
