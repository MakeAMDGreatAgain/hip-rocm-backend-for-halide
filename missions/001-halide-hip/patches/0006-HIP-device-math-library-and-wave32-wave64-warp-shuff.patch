+            intrin_suffix = hip ? "_f32" : ".f32";
         } else {
-            intrin_suffix = ".i32";
+            intrin_suffix = hip ? "_i32" : ".i32";
+        }
+
+        Expr membermask = (int)0xffffffff;
+
+        // The three shuffle shapes. On CUDA these are the llvm.nvvm.shfl
+        // intrinsics, whose last argument packs a segment mask and a clamp
+        // lane (see the comments at the uses below). On HIP they are the
+        // halide_amdgpu_shfl_* helpers defined in amdgpu_dev.ll, which take
+        // the width of the segment being shuffled within instead. That is
+        // always the warp size chosen for this lane loop, which keeps the
+        // Halide warps packed into one hardware wavefront (e.g. two 32-lane
