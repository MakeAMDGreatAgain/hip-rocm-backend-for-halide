diff --git a/src/runtime/amdgpu_dev.ll b/src/runtime/amdgpu_dev.ll
new file mode 100644
index 0000000..e16bd07
--- /dev/null
+++ b/src/runtime/amdgpu_dev.ll
@@ -0,0 +1,3841 @@
+; Device-side helper module for the AMDGPU (HIP) backend.
+;
+; This module is linked into every HIP kernel module by
+; get_initial_module_for_amdgpu_device() (src/LLVM_Runtime_Linker.cpp).
+; Like ptx_dev.ll it deliberately carries no target triple and no data
+; layout: CodeGen_AMDGPU_Dev sets both from its TargetMachine so they can
+; never drift from the LLVM in use. Every definition here must be inlinable
+; (they are re-marked available_externally after linking, and nothing may
+; survive as an out-of-line call because the code object is linked with
+; --no-undefined), so everything is weak_odr + alwaysinline, leaf-only, and
+; free of address-space assumptions.
+;
+; Layout of this file:
+;   1. intrinsic declarations
+;   2. constants (nan/inf) and thin wrappers over native instructions
+;      (sqrt, floor, ceil, trunc, round, abs, fast_inverse[_sqrt])
+;   3. halide_amdgpu_trap
+;   4. transcendental math for f32 and f64 (sin ... atanh, exp, log, pow)
+;   5. warp shuffles used by LowerWarpShuffles for DeviceAPI::HIP
+;
+; Section 4 is generated: the algorithms are written once in a small DSL
+; (scripts kept with the HIP design notes, gen_amdgpu_dev.py) that emits this
+; IR and also emulates it with exact per-operation IEEE rounding, so the
+; accuracy figures below were measured on precisely these instruction
+; sequences. AMDGPU has no device libm and LLVM lowers llvm.sin/exp/log/pow on
+; f64 to libcalls, so real implementations are required here. Phase 2 of the
+; HIP backend is expected to replace this section with the ROCm device
+; library (ocml.bc); until then:
+;
+;   f32: measured max error vs. an 80-digit reference (the generator's exact
+;   emulation) and vs. glibc long double libm (the IR compiled for x86-64),
+;   random sampling of 2e5 points per domain
+;     sin/cos    <= 1.5 ulp for |x| < 2^52 (f32 reduction below 2^14, f64 above)
+;     tan        <= 3.2 ulp
+;     exp        <= 0.9 ulp     log <= 0.9 ulp      pow <= 0.5 ulp (computed in f64)
+;     asin/acos <= 4.8 ulp, atan <= 3.8 ulp, atan2 <= 4.6 ulp (3e-7 relative)
+;     sinh/cosh <= 2.8 ulp, tanh <= 2.4 ulp, asinh/acosh/atanh <= 2.9 ulp
+;   f64:
+;     sin/cos    <= 1.5 ulp for |x| < 2^52 (double-double Cody-Waite reduction)
+;     tan        <= 2.6 ulp
+;     exp        <= 0.9 ulp     log <= 1.2 ulp
+;     pow        <= 0.7 ulp over the whole range (y*log(x) is carried as a
+;                double-double, so the error does not grow with |y*ln(x)|;
+;                representable results such as pow(2, 3) or pow(-2, 4) are exact)
+;     asin/acos/atan2 <= 4.7 ulp, atan <= 1 ulp, sinh/cosh <= 2.8 ulp,
+;     tanh <= 2.2 ulp, asinh/acosh/atanh <= 2.6 ulp
+;   Both: sin/cos/tan of |x| >= 2^52 return NaN (no Payne-Hanek reduction);
+;   pow follows the C99 special cases for 0, +-1, +-inf and NaN arguments;
+;   f32 runs with denormals flushed (preserve-sign) so log of a subnormal f32
+;   is -inf.
+;
+; CodeGen_LLVM handles pow_f32/exp_f32/log_f32 and is_nan/is_inf/is_finite
+; itself (see CodeGen_LLVM::visit(const Call *)), so those f32 entry points
+; are only here for parity with ptx_dev.ll; the f64 ones are load-bearing.
+
+; ---------------------------------------------------------------------------
+; 1. Intrinsics
+; ---------------------------------------------------------------------------
+
+; SIMT indices. CodeGen_AMDGPU_Dev::simt_intrinsic() calls these by name.
+declare i32 @llvm.amdgcn.workitem.id.x()
+declare i32 @llvm.amdgcn.workitem.id.y()
+declare i32 @llvm.amdgcn.workitem.id.z()
+declare i32 @llvm.amdgcn.workgroup.id.x()
+declare i32 @llvm.amdgcn.workgroup.id.y()
+declare i32 @llvm.amdgcn.workgroup.id.z()
+
+; Workgroup barrier. CodeGen_AMDGPU_Dev::visit(const Call *) emits it inline,
+; wrapped in workgroup/agent-scope fences (s_barrier alone is not a memory
+; fence). No halide_gpu_thread_barrier helper is defined here on purpose.
+declare void @llvm.amdgcn.s.barrier()
+
+declare void @llvm.trap() noreturn nounwind
+
+; Native reciprocal / reciprocal square root (1 ulp, no denormal handling).
+declare float @llvm.amdgcn.rcp.f32(float) nounwind readnone
+declare half @llvm.amdgcn.rcp.f16(half) nounwind readnone
+declare float @llvm.amdgcn.rsq.f32(float) nounwind readnone
+declare half @llvm.amdgcn.rsq.f16(half) nounwind readnone
+
+; Generic LLVM intrinsics; all of these lower to single instructions (or
+; short correctly-rounded sequences for sqrt/fdiv) on every supported gfx.
+declare half @llvm.sqrt.f16(half) nounwind readnone
+declare float @llvm.floor.f32(float) nounwind readnone
+declare double @llvm.floor.f64(double) nounwind readnone
+declare half @llvm.floor.f16(half) nounwind readnone
+declare float @llvm.ceil.f32(float) nounwind readnone
+declare double @llvm.ceil.f64(double) nounwind readnone
+declare half @llvm.ceil.f16(half) nounwind readnone
+declare float @llvm.trunc.f32(float) nounwind readnone
+declare double @llvm.trunc.f64(double) nounwind readnone
+declare half @llvm.trunc.f16(half) nounwind readnone
+declare float @llvm.roundeven.f32(float) nounwind readnone
+declare double @llvm.roundeven.f64(double) nounwind readnone
+declare half @llvm.roundeven.f16(half) nounwind readnone
+declare half @llvm.fabs.f16(half) nounwind readnone
+; Generic intrinsics used by the transcendental section.
+declare double @llvm.copysign.f64(double, double) nounwind readnone
+declare double @llvm.fabs.f64(double) nounwind readnone
+declare double @llvm.fma.f64(double, double, double) nounwind readnone
+declare double @llvm.rint.f64(double) nounwind readnone
+declare double @llvm.sqrt.f64(double) nounwind readnone
+declare float @llvm.copysign.f32(float, float) nounwind readnone
+declare float @llvm.fabs.f32(float) nounwind readnone
+declare float @llvm.fma.f32(float, float, float) nounwind readnone
+declare float @llvm.rint.f32(float) nounwind readnone
+declare float @llvm.sqrt.f32(float) nounwind readnone
+
+; ---------------------------------------------------------------------------
+; 2. Constants and wrappers over native instructions
+; ---------------------------------------------------------------------------
+
+define weak_odr float @nan_f32() nounwind readnone alwaysinline {
+       ret float 0x7FF8000000000000
+}
+
+define weak_odr float @neg_inf_f32() nounwind readnone alwaysinline {
+       ret float 0xFFF0000000000000
+}
+
+define weak_odr float @inf_f32() nounwind readnone alwaysinline {
+       ret float 0x7FF0000000000000
+}
+
+; sqrt: correctly rounded (LLVM's AMDGPU lowering scales denormals and
+; refines v_sqrt_f32 / v_sqrt_f64 unless afn is set, which Halide never
+; requests for these).
+define weak_odr float @sqrt_f32(float %x) nounwind readnone alwaysinline {
+       %y = tail call float @llvm.sqrt.f32(float %x) nounwind readnone
+       ret float %y
+}
+
+define weak_odr double @sqrt_f64(double %x) nounwind readnone alwaysinline {
+       %y = tail call double @llvm.sqrt.f64(double %x) nounwind readnone
+       ret double %y
+}
+
+define weak_odr half @sqrt_f16(half %x) nounwind readnone alwaysinline {
+       %y = tail call half @llvm.sqrt.f16(half %x) nounwind readnone
+       ret half %y
+}
+
+define weak_odr float @floor_f32(float %x) nounwind readnone alwaysinline {
+       %y = tail call float @llvm.floor.f32(float %x) nounwind readnone
+       ret float %y
+}
+
+define weak_odr double @floor_f64(double %x) nounwind readnone alwaysinline {
+       %y = tail call double @llvm.floor.f64(double %x) nounwind readnone
+       ret double %y
+}
+
+define weak_odr half @floor_f16(half %x) nounwind readnone alwaysinline {
+       %y = tail call half @llvm.floor.f16(half %x) nounwind readnone
+       ret half %y
+}
+
+define weak_odr float @ceil_f32(float %x) nounwind readnone alwaysinline {
+       %y = tail call float @llvm.ceil.f32(float %x) nounwind readnone
+       ret float %y
+}
+
+define weak_odr double @ceil_f64(double %x) nounwind readnone alwaysinline {
+       %y = tail call double @llvm.ceil.f64(double %x) nounwind readnone
+       ret double %y
+}
