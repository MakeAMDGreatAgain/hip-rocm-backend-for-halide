@@ -0,0 +1,39 @@
+#include "Halide.h"
+#include <stdio.h>
+
+using namespace Halide;
+
+// A gpu_lanes loop may not be wider than the hardware wavefront. gfx1100
+// (RDNA3) runs Halide kernels in wave32 mode, so 64 lanes must be rejected
+// during lowering (LowerWarpShuffles). Lowering only; no device is needed.
+
+int main(int argc, char **argv) {
+    Target target("host-hip-hip_gfx1100");
+    if (!target.supported()) {
+        printf("[SKIP] Halide was built without the AMDGPU backend.\n");
+        // An error test has to report an error even when it skips.
+        _halide_user_assert(0);
+    }
+
+    Func f("f"), g("g");
+    Var x("x"), y("y"), xo("xo"), xi("xi"), yi("yi");
+
+    f(x, y) = cast<uint8_t>(x + y);
+    g(x, y) = f(x - 1, y) + f(x + 1, y);
+
+    g.gpu_tile(x, y, xi, yi, 64, 2, TailStrategy::RoundUp)
+        .gpu_lanes(xi);
+
+    f.compute_root();
+
+    f.in(g)
+        .compute_at(g, yi)
+        .split(x, xo, xi, 64, TailStrategy::RoundUp)
+        .gpu_lanes(xi)
+        .unroll(xo);
+
+    g.compile_to_module(g.infer_arguments(), "hip_gpu_lanes_too_wide", target);
+
+    printf("Success!\n");
+    return 0;
+}
